---
import * as stylex from '@stylexjs/stylex'
import ServicesAccordion from './services/ServicesAccordion'
import { SERVICES, SERVICES_FAQS } from '../data/services'
import { servicesStyles } from './ui/services.stylex'
import { kicker } from './ui/primitives'
import { a11y } from './ui/primitives'

const steps = [
  {
    name: 'Discovery call',
    desc: 'A free 30-minute call to understand your goals, constraints, and what success looks like.',
  },
  {
    name: 'Scope & proposal',
    desc: 'You get a written scope with deliverables, a timeline, and a fixed price. No surprises, no scope creep.',
  },
  {
    name: 'Delivery',
    desc: 'We work in short cycles with regular check-ins, so you see real progress as it happens.',
  },
  {
    name: 'Handoff & support',
    desc: 'Code, docs, and knowledge transfer — plus optional ongoing support when you need it.',
  },
] as const
---

<section aria-labelledby="ep-engagement-heading">
  <h2 id="ep-engagement-heading" {...stylex.attrs(a11y.srOnly)}>Engagement and pricing</h2>

  <p {...stylex.attrs(servicesStyles.intro)}>
    Senior architecture, engineering, and AI leadership for startups and enterprises. Work is
    scoped in writing and delivered by me directly. Open an engagement to see what's included.
  </p>

  <ServicesAccordion services={SERVICES} client:idle />

  <section {...stylex.attrs(servicesStyles.section)} aria-labelledby="ep-process-heading">
    <h3 id="ep-process-heading" {...stylex.attrs(kicker.eyebrow)}>
      How engagements work
    </h3>
    <ol {...stylex.attrs(servicesStyles.processList)}>
      {steps.map((step, i) => (
        <li {...stylex.attrs(servicesStyles.processItem)}>
          <span {...stylex.attrs(servicesStyles.processNum)}>0{i + 1}</span>
          <div>
            <p {...stylex.attrs(servicesStyles.processName)}>{step.name}</p>
            <p {...stylex.attrs(servicesStyles.processDesc)}>{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section {...stylex.attrs(servicesStyles.section)} aria-labelledby="ep-faq-heading">
    <h3 id="ep-faq-heading" {...stylex.attrs(kicker.eyebrow)}>
      Common questions
    </h3>
    <div {...stylex.attrs(servicesStyles.faqList)}>
      {SERVICES_FAQS.map((faq) => (
        <details {...stylex.attrs(servicesStyles.faqItem)} data-faq-item>
          <summary {...stylex.attrs(servicesStyles.summary)}>
            <span {...stylex.attrs(servicesStyles.summaryText)}>{faq.q}</span>
            <span {...stylex.attrs(servicesStyles.chevron)} data-faq-chevron>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
            </span>
          </summary>
          <div {...stylex.attrs(servicesStyles.faqBody)} data-faq-body>
            <p {...stylex.attrs(servicesStyles.faqAnswer)}>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

</section>
