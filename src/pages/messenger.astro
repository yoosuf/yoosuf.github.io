---
import messengerBodySource from '../components/product/MessengerBody.astro?raw'
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductLayout from '../layouts/ProductLayout.astro'
import MessengerBody from '../components/product/MessengerBody.astro'
import Terminal from '../components/product/Terminal.astro'
import { messenger } from '../data/product'
import { SITE } from '../config'
import { extractFaqItems } from '../data/faq'

const messengerFaqs = extractFaqItems(messengerBodySource, 'messenger')

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE.url}/messenger/#faq`,
  isPartOf: { '@id': `${SITE.url}/messenger/` },
  mainEntity: messengerFaqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
}

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${SITE.url}/messenger/#software`,
  name: 'Messenger',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description:
    'An open source relational chat schema for one-to-one and group messaging: users, conversations, participants, messages, attachments, moderation (reports & blocks), device sessions, and per-user visibility. A database foundation for Node.js or Go chat backends on PostgreSQL or MySQL.',
  url: `${SITE.url}/messenger/`,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'One-to-one and group chat models',
    'Message persistence and relational integrity',
    'Per-user delete visibility and conversation hide',
    'Report and block models for moderation',
    'Device registration and token access',
    'Attachment and gallery tables for media messaging',
    'Activity and audit logging',
  ],
  codeRepository: 'https://github.com/yoosuf/Messenger',
  downloadUrl: 'https://github.com/yoosuf/Messenger/blob/master/messenger.sql',
  author: { '@type': 'Person', name: 'Yoosuf Mohamed', url: SITE.url },
  publisher: { '@type': 'Person', name: 'Yoosuf Mohamed', url: SITE.url },
}
---

<BaseLayout
  title={messenger.seo.title}
  description={messenger.seo.description}
  keywords={messenger.seo.keywords}
  canonical={messenger.seo.canonical}
  type="softwareApplication"
  mainEntity={`${SITE.url}/messenger/#software`}
  jsonLd={[softwareJsonLd, faqJsonLd]}
>
  <ProductLayout product={messenger}>
    <div slot="media">
      <Terminal
        title="messenger.sql — schema"
        ariaLabel="Messenger schema import in a terminal"
        lines={[
          { kind: 'cmd', code: 'mysql -u app -p chatdb < messenger.sql' },
          { kind: 'ok', code: '16 tables created' },
          { kind: 'out', code: '' },
          { kind: 'cmd', lang: 'sql', code: 'SELECT * FROM messages;' },
          {
            kind: 'out',
            code: [
              'users                 user_verification',
              'contacts              user_contact',
              'conversation          participants',
              'messages              attachments',
              'deleted_messages      deleted_conversations',
              'block_list            reports',
              'devices               access',
              'activities',
            ].join('\n'),
          },
          { kind: 'ok', code: 'ready for your API layer' },
        ]}
      />
    </div>

    <MessengerBody />
  </ProductLayout>
</BaseLayout>