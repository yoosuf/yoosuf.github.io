---
import * as stylex from '@stylexjs/stylex'
import type { CollectionEntry } from 'astro:content'
import { postCardStyles } from './ui/postCard.stylex'
import { kicker } from './ui/primitives'
import { decodeEntities, ensureTrailingSlash, formatShortDate, readingTime, toISODate } from '../lib/utils'

interface Props {
  post: CollectionEntry<'blog'>
  headingLevel?: 'h2' | 'h3'
  divider?: boolean
}

const { post, headingLevel = 'h2', divider = false } = Astro.props
const { title, date, description, permalink } = post.data
const url = ensureTrailingSlash(permalink)
const HeadingTag = headingLevel
---

<li {...stylex.attrs(postCardStyles.row, divider && postCardStyles.divider)} data-home-hook="y-post-card">
  <time {...stylex.attrs(kicker.date)} datetime={toISODate(date)}>
    {formatShortDate(date)}
  </time>

  <HeadingTag {...stylex.attrs(postCardStyles.heading)} data-home-hook="y-post-heading">
    <a href={url} {...stylex.attrs(postCardStyles.titleLink)} data-home-hook="y-post-title">
      {decodeEntities(title)}
    </a>
  </HeadingTag>

  {description && (
    <p {...stylex.attrs(postCardStyles.desc)}>
      {description}
    </p>
  )}
</li>
