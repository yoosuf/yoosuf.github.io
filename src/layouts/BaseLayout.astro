---
import { SITE, PERSON_JSON_LD, ORG_JSON_LD, WEBSITE_JSON_LD } from '../config'
import { ClientRouter } from 'astro:transitions'
import * as stylex from '@stylexjs/stylex'
import { shellStyles } from '../components/ui/shell.stylex'
import { pageStyles } from '../components/ui/page.stylex'
import Header from '../components/header/Header.astro'
import Footer from '../components/Footer.astro'
import SiteCta from '../components/SiteCta.astro'

interface ArticleMeta {
  published?: string
  modified?: string
  section?: string
  tags?: string[]
}

export interface Props {
  title?: string
  metaTitle?: string
  description?: string
  image?: string
  imageAlt?: string
  keywords?: string
  canonical?: string
  type?: 'website' | 'article' | 'profile' | 'softwareApplication'
  /** Schema.org type for the page node. `WebPage` is the safe default; use a
   *  more specific subtype (e.g. `CollectionPage`) where it is accurate. */
  pageType?: 'WebPage' | 'CollectionPage' | 'ItemPage' | 'ProfilePage' | 'AboutPage' | 'ContactPage'
  /** `@id` of the node this page is really about, when it differs from the page. */
  mainEntity?: string
  jsonLd?: object[]
  article?: ArticleMeta
  noIndex?: boolean
}

const {
  title,
  metaTitle,
  description = SITE.description,
  image = SITE.socialImage,
  imageAlt = 'Yoosuf Mohamed — Systems Architect. AI Automation & AI-First Products.',
  keywords,
  canonical,
  type = 'website',
  pageType = 'WebPage',
  mainEntity,
  jsonLd = [],
  article,
  noIndex = false,
} = Astro.props

// `metaTitle` wins when a page needs a shorter search/social title than its
// visible headline.
const pageTitle = metaTitle ?? title ?? SITE.title
const canonicalUrl = canonical ? new URL(canonical, SITE.url).href : null
const pageUrl = canonicalUrl ?? new URL(Astro.url.pathname, SITE.url).href
const imageUrl = image.startsWith('http') ? image : new URL(image, SITE.url).href

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': pageType,
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageTitle,
  description,
  inLanguage: SITE.lang,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#person` },
  ...(mainEntity ? { mainEntity: { '@id': mainEntity } } : {}),
  ...(article?.published
    ? {
        datePublished: article.published,
        dateModified: article.modified ?? article.published,
      }
    : {}),
}

const og = {
  title: pageTitle,
  type,
  url: canonicalUrl ?? new URL(Astro.url.pathname, SITE.url).href,
  image: imageUrl,
  imageWidth: '1200',
  imageHeight: '630',
  siteName: SITE.title,
  locale: SITE.locale,
}
const mainAttrs = stylex.attrs(shellStyles.main)
---

<!doctype html>
<html {...stylex.attrs(shellStyles.html)} lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {noIndex ? (
      <meta name="robots" content="noindex, nofollow, noarchive" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}
    <meta name="author" content={SITE.author} />

    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e0e" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — RSS`} href="/feed.xml" />

    {import.meta.env.DEV && (
      <>
        {/* StyleX dev virtual stylesheet + HMR runtime (build extracts CSS instead) */}
        <link rel="stylesheet" href="/virtual:stylex.css" />
        <script type="module" src="/@id/virtual:stylex:runtime"></script>
      </>
    )}

    <ClientRouter />

    <style is:global>
      /* -------------------------------------------------------------------
        Base layer — reset, selection/focus, motion guard, syntax + diagram
        theming, and descendant/composite behaviour StyleX atomics can't
        express (group-hover and `[data-home-hook]` relationships). Uses the
        same palette pairs as tokens.stylex.ts via light-dark(), resolved by
        the `color-scheme: light dark` shellStyles.html class on <html>.

        `@layer base` is declared FIRST so the compiled StyleX atoms (emitted
        into their own later `priority1`/`priority2` layers) out-cascade it
        wherever an atom exists. Only the narrow override rules below it are
        unlayered (or !important) so they beat both atoms and Prism's token
        span colors.
      ------------------------------------------------------------------- */
      @layer base {
        *,
        *::before,
        *::after,
        ::backdrop,
        ::file-selector-button {
          box-sizing: border-box;
          margin: 0;
          padding: 0;
          border: 0 solid;
        }

        html {
          line-height: 1.5;
          -webkit-text-size-adjust: 100%;
          text-size-adjust: 100%;
          tab-size: 4;
          -webkit-tap-highlight-color: transparent;
        }

        body {
          line-height: inherit;
        }

        hr {
          height: 0;
          color: inherit;
          border-top-width: 1px;
        }

        abbr[title] {
          text-decoration: underline dotted;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
          font-size: inherit;
          font-weight: inherit;
        }

        a {
          color: inherit;
          -webkit-text-decoration: inherit;
          text-decoration: inherit;
        }

        b,
        strong {
          font-weight: bolder;
        }

        small {
          font-size: 80%;
        }

        sub,
        sup {
          font-size: 75%;
          line-height: 0;
          position: relative;
          vertical-align: baseline;
        }

        sub {
          bottom: -0.25em;
        }

        sup {
          top: -0.5em;
        }

        table {
          text-indent: 0;
          border-color: inherit;
          border-collapse: collapse;
        }

        button,
        input,
        optgroup,
        select,
        textarea,
        ::file-selector-button {
          font: inherit;
          font-feature-settings: inherit;
          font-variation-settings: inherit;
          letter-spacing: inherit;
          color: inherit;
          border-radius: 0;
          background-color: transparent;
          opacity: 1;
        }

        button,
        select {
          text-transform: none;
        }

        button,
        input[type='button'],
        input[type='reset'],
        input[type='submit'],
        ::file-selector-button {
          appearance: button;
        }

        input[type='search'] {
          -webkit-appearance: none;
          appearance: none;
          outline-offset: -2px;
        }

        ::-webkit-search-decoration {
          -webkit-appearance: none;
        }

        textarea {
          resize: vertical;
        }

        summary {
          display: list-item;
        }

        ol,
        ul,
        menu {
          list-style: none;
        }

        blockquote,
        dl,
        dd,
        figure,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        hr,
        p,
        pre {
          margin: 0;
        }

        fieldset {
          margin: 0;
          padding: 0;
        }

        legend {
          padding: 0;
        }

        button,
        [role='button'] {
          cursor: pointer;
        }

        /* Touch targets: drop the 300ms double-tap zoom delay on mobile. */
        a,
        button,
        summary,
        [role='button'],
        [role='tab'] {
          touch-action: manipulation;
        }

        :disabled {
          cursor: default;
        }

        img,
        svg,
        video,
        canvas,
        audio,
        iframe,
        embed,
        object {
          display: block;
          vertical-align: middle;
        }

        img,
        video {
          max-width: 100%;
          height: auto;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
          text-wrap: balance;
        }

        p {
          text-wrap: pretty;
        }

        a {
          transition: color 0.15s ease;
        }

        @media (prefers-reduced-motion: reduce) {
          *,
          *::before,
          *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
          }

          ::view-transition-group(*),
          ::view-transition-old(*),
          ::view-transition-new(*) {
            animation-duration: 0s !important;
          }
        }

        @media (prefers-reduced-motion: no-preference) {
          .yt-first main#site-main {
            animation: page-fade 0.45s ease-out both;
          }
        }

        @keyframes page-fade {
          from {
            opacity: 0;
          }
          to {
            opacity: 1;
          }
        }
      }

      /* Selection + focus ring: keep unlayered so they outrank any atom. */
      ::selection {
        background: color-mix(in srgb, light-dark(#2563eb, #8bb0ff) 22%, transparent);
      }

      :is(a, button, summary, [tabindex]):focus-visible {
        outline: 2px solid light-dark(#2563eb, #8bb0ff);
        outline-offset: 2px;
        border-radius: 2px;
      }

      [id] {
        scroll-margin-top: 6rem;
      }

      /* Site header height the product subnav sits below (hamburger makes the
         mobile bar taller; breakpoint parity with the 48rem nav switch). */
      :root {
        --site-header-h: 77px;
      }

      @media (min-width: 48rem) {
        :root {
          --site-header-h: 64px;
        }
      }

      /* Product microsites: the subnav sticks below the site header, so
         anchored targets must clear the taller sticky stack (header+subnav). */
      [data-pm-hook='pm-page'] [id] {
        scroll-margin-top: calc(var(--site-header-h) + 3.25rem);
      }

      /* Prism code samples: Prism replaces the markdown `<pre><code>` tree with
         its own `class="language-*"` markup, so it bypasses the markdown
         components' StyleX atomics. Replicate the markdown.stylex.ts pre/code
         design here (same palette pairs, light-dark() resolved against the
         `color-scheme: light dark` on the document shell), keep long
         unbreakable tokens inside an internal scroll strip (site-wide
         no-overflow rule), and paint the token spans. Mermaid pres are matched
         by Pre.astro and never carry the `language-*` class. */
      pre[class*='language-'] {
        background-color: light-dark(#f6f6f6, #171717);
        border: 1px solid light-dark(#e5e5e5, #2b2b2b);
        border-radius: 8px;
        color: light-dark(#1a1a1a, #e6e6e6);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        font-size: 0.88em;
        line-height: 1.7;
        margin-block: 1.25em;
        max-width: 100%;
        overflow-x: auto;
        padding-block: 1em;
        padding-inline: 1.25em;
        text-align: left;
        white-space: pre;
      }
      pre[class*='language-'] > code {
        background: none;
        border: 0;
        color: inherit;
        font-family: inherit;
        font-size: inherit;
        padding: 0;
      }

      /* Prism token palette — a restrained graphite + accent-blue theme tuned
         to the site's tokens (see tokens.stylex.ts). */
      code[class*='language-'] .token.comment,
      code[class*='language-'] .token.prolog,
      code[class*='language-'] .token.doctype,
      code[class*='language-'] .token.cdata {
        color: light-dark(#747474, #7f7f7f);
        font-style: italic;
      }
      code[class*='language-'] .token.punctuation {
        color: light-dark(#5e5e5e, #979797);
      }
      code[class*='language-'] .token.property,
      code[class*='language-'] .token.attr-name {
        color: light-dark(#2563eb, #8bb0ff);
      }
      code[class*='language-'] .token.tag,
      code[class*='language-'] .token.boolean,
      code[class*='language-'] .token.number,
      code[class*='language-'] .token.constant,
      code[class*='language-'] .token.symbol,
      code[class*='language-'] .token.class-name,
      code[class*='language-'] .token.this {
        color: light-dark(#1d4ed8, #a9c4ff);
      }
      code[class*='language-'] .token.selector,
      code[class*='language-'] .token.keyword,
      code[class*='language-'] .token.atrule,
      code[class*='language-'] .token.attr-name.keyword {
        color: light-dark(#2563eb, #8bb0ff);
      }
      code[class*='language-'] .token.string,
      code[class*='language-'] .token.char,
      code[class*='language-'] .token.attr-value,
      code[class*='language-'] .token.builtin,
      code[class*='language-'] .token.inserted {
        color: light-dark(#9a4f00, #dcb37f);
      }
      code[class*='language-'] .token.operator,
      code[class*='language-'] .token.entity,
      code[class*='language-'] .token.url,
      code[class*='language-'] .token.deleted {
        color: light-dark(#5e5e5e, #b0b0b0);
      }
      code[class*='language-'] .token.function,
      code[class*='language-'] .token.variable {
        color: light-dark(#1a1a1a, #e6e6e6);
      }
      code[class*='language-'] .token.regex,
      code[class*='language-'] .token.important {
        color: light-dark(#5e5e5e, #b0b0b0);
        font-weight: 600;
      }
      code[class*='language-'] .token.bold {
        font-weight: 700;
      }
      code[class*='language-'] .token.italic {
        font-style: italic;
      }

      /* Group-hover composites for the data-home-hook relationship classes. */
      [data-home-hook='product-card']:hover [data-home-hook='y-product-title'],
      [data-home-hook='y-post-card']:hover [data-home-hook='y-post-title'] {
        color: light-dark(#2563eb, #8bb0ff);
      }
      [data-home-hook='y-post-card']:hover [data-home-hook='y-post-title'] {
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        text-decoration-color: color-mix(in srgb, light-dark(#2563eb, #8bb0ff) 30%, transparent);
      }
      [data-home-hook='y-post-card']:hover [data-home-hook='y-post-heading'],
      [data-home-hook='product-card']:hover [data-home-hook='y-product-arrow'] {
        transform: translateX(4px);
      }
      [data-home-hook='svc-item']:hover [data-home-hook='svc-name'],
      [data-home-hook='svc-item']:hover [data-home-hook='svc-chip'] {
        color: light-dark(#2563eb, #8bb0ff);
      }
      [data-home-hook='post-pager-link']:hover [data-home-hook='post-pager-title'] {
        color: light-dark(#2563eb, #8bb0ff);
      }

      /* FAQ accordion (native `<details>`) — StyleX can't express the
         `[open]` ancestor state, so chevron flip, item dividers, marker
         removal, and the open animation are composited here. */
      [data-faq-item] > summary::-webkit-details-marker {
        display: none;
      }
      [data-faq-item] + [data-faq-item] {
        border-top-color: light-dark(#e5e5e5, #2b2b2b);
        border-top-style: solid;
        border-top-width: 1px;
      }
      [data-faq-item][open] [data-faq-chevron] {
        color: light-dark(#2563eb, #8bb0ff);
        transform: rotate(180deg);
      }
      @media (prefers-reduced-motion: no-preference) {
        [data-faq-item][open] [data-faq-body] {
          animation: faq-body-in 0.25s ease-out;
        }
      }
      @keyframes faq-body-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      /* Dark code palette — the product microsites' fixed-dark surfaces.
         The terminal scrollback and the API/install code panels are all dark
         mockups in both colour schemes, so they share one palette instead of
         the `light-dark()` markdown theme above. A GitHub Dark-derived set:
         every value clears 4.5:1 on --pm-term-bg (#101010). Plain CSS rather
         than StyleX because the token spans are injected via `set:html` and
         StyleX cannot see inside them. */
      [data-pm-hook='pm-terminal-lines'] .token.comment,
      [data-pm-hook='pm-terminal-lines'] .token.prolog,
      [data-pm-hook='pm-terminal-lines'] .token.doctype,
      [data-pm-hook='pm-terminal-lines'] .token.cdata,
      [data-pm-hook='pm-code-block'] .token.comment,
      [data-pm-hook='pm-code-block'] .token.prolog,
      [data-pm-hook='pm-code-block'] .token.doctype,
      [data-pm-hook='pm-code-block'] .token.cdata,
      [data-pm-hook='pm-install-code'] .token.comment,
      [data-pm-hook='pm-install-code'] .token.prolog,
      [data-pm-hook='pm-install-code'] .token.doctype,
      [data-pm-hook='pm-install-code'] .token.cdata {
        color: #7d8590;
        font-style: italic;
      }
      [data-pm-hook='pm-terminal-lines'] .token.punctuation,
      [data-pm-hook='pm-terminal-lines'] .token.operator,
      [data-pm-hook='pm-terminal-lines'] .token.entity,
      [data-pm-hook='pm-terminal-lines'] .token.url,
      [data-pm-hook='pm-code-block'] .token.punctuation,
      [data-pm-hook='pm-code-block'] .token.operator,
      [data-pm-hook='pm-code-block'] .token.entity,
      [data-pm-hook='pm-code-block'] .token.url,
      [data-pm-hook='pm-install-code'] .token.punctuation,
      [data-pm-hook='pm-install-code'] .token.operator,
      [data-pm-hook='pm-install-code'] .token.entity,
      [data-pm-hook='pm-install-code'] .token.url {
        color: #8b949e;
      }
      [data-pm-hook='pm-terminal-lines'] .token.keyword,
      [data-pm-hook='pm-terminal-lines'] .token.atrule,
      [data-pm-hook='pm-terminal-lines'] .token.important,
      [data-pm-hook='pm-terminal-lines'] .token.bold,
      [data-pm-hook='pm-code-block'] .token.keyword,
      [data-pm-hook='pm-code-block'] .token.atrule,
      [data-pm-hook='pm-code-block'] .token.important,
      [data-pm-hook='pm-code-block'] .token.bold,
      [data-pm-hook='pm-install-code'] .token.keyword,
      [data-pm-hook='pm-install-code'] .token.atrule,
      [data-pm-hook='pm-install-code'] .token.important,
      [data-pm-hook='pm-install-code'] .token.bold {
        color: #ff7b72;
        font-weight: 600;
      }
      [data-pm-hook='pm-terminal-lines'] .token.function,
      [data-pm-hook='pm-terminal-lines'] .token.class-name,
      [data-pm-hook='pm-code-block'] .token.function,
      [data-pm-hook='pm-code-block'] .token.class-name,
      [data-pm-hook='pm-install-code'] .token.function,
      [data-pm-hook='pm-install-code'] .token.class-name {
        color: #d2a8ff;
      }
      [data-pm-hook='pm-terminal-lines'] .token.property,
      [data-pm-hook='pm-terminal-lines'] .token.attr-name,
      [data-pm-hook='pm-terminal-lines'] .token.constant,
      [data-pm-hook='pm-terminal-lines'] .token.boolean,
      [data-pm-hook='pm-terminal-lines'] .token.inserted,
      [data-pm-hook='pm-code-block'] .token.property,
      [data-pm-hook='pm-code-block'] .token.attr-name,
      [data-pm-hook='pm-code-block'] .token.constant,
      [data-pm-hook='pm-code-block'] .token.boolean,
      [data-pm-hook='pm-code-block'] .token.inserted,
      [data-pm-hook='pm-install-code'] .token.property,
      [data-pm-hook='pm-install-code'] .token.attr-name,
      [data-pm-hook='pm-install-code'] .token.constant,
      [data-pm-hook='pm-install-code'] .token.boolean,
      [data-pm-hook='pm-install-code'] .token.inserted {
        color: #7ee787;
      }
      [data-pm-hook='pm-terminal-lines'] .token.string,
      [data-pm-hook='pm-terminal-lines'] .token.char,
      [data-pm-hook='pm-terminal-lines'] .token.attr-value,
      [data-pm-hook='pm-code-block'] .token.string,
      [data-pm-hook='pm-code-block'] .token.char,
      [data-pm-hook='pm-code-block'] .token.attr-value,
      [data-pm-hook='pm-install-code'] .token.string,
      [data-pm-hook='pm-install-code'] .token.char,
      [data-pm-hook='pm-install-code'] .token.attr-value {
        color: #a5d6ff;
      }
      [data-pm-hook='pm-terminal-lines'] .token.number,
      [data-pm-hook='pm-terminal-lines'] .token.symbol,
      [data-pm-hook='pm-terminal-lines'] .token.regex,
      [data-pm-hook='pm-terminal-lines'] .token.builtin,
      [data-pm-hook='pm-code-block'] .token.number,
      [data-pm-hook='pm-code-block'] .token.symbol,
      [data-pm-hook='pm-code-block'] .token.regex,
      [data-pm-hook='pm-code-block'] .token.builtin,
      [data-pm-hook='pm-install-code'] .token.number,
      [data-pm-hook='pm-install-code'] .token.symbol,
      [data-pm-hook='pm-install-code'] .token.regex,
      [data-pm-hook='pm-install-code'] .token.builtin {
        color: #79c0ff;
      }
      /* Command flags (`-d`, `--name`, `-p`) tokenise as `parameter variable`. */
      [data-pm-hook='pm-terminal-lines'] .token.parameter,
      [data-pm-hook='pm-terminal-lines'] .token.variable,
      [data-pm-hook='pm-code-block'] .token.parameter,
      [data-pm-hook='pm-code-block'] .token.variable,
      [data-pm-hook='pm-install-code'] .token.parameter,
      [data-pm-hook='pm-install-code'] .token.variable {
        color: #ffa657;
      }

      /* Prompt and success glyphs in the terminal. These live here rather than
         in the StyleX module because both are injected through set:html
         alongside the token spans, so they are styled by the same mechanism. */
      [data-pm-hook='pm-prompt'] {
        color: var(--pm-term-prompt);
        font-weight: 700;
      }
      [data-pm-hook='pm-ok'] {
        color: var(--pm-term-ok);
        font-weight: 700;
      }
    </style>

    <meta property="og:title" content={og.title} />
    <meta property="og:type" content={og.type} />
    <meta property="og:url" content={og.url} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.image} />
    <meta property="og:image:width" content={og.imageWidth} />
    <meta property="og:image:height" content={og.imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content={og.siteName} />
    <meta property="og:locale" content={og.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:domain" content="yoosuf.me" />
    <meta name="twitter:site" content="@aitchdei" />
    <meta name="twitter:creator" content="@aitchdei" />

    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        <meta property="article:modified_time" content={article.modified ?? article.published} />
        <meta property="og:updated_time" content={article.modified ?? article.published} />
        <meta property="article:author" content={`${SITE.url}/about/`} />
        {article.section && <meta property="article:section" content={article.section} />}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(ORG_JSON_LD)} />
    <script type="application/ld+json" set:html={JSON.stringify(WEBSITE_JSON_LD)} />
    <script type="application/ld+json" set:html={JSON.stringify(PERSON_JSON_LD)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {import.meta.env.PROD && (
      <script
        is:inline
        set:html={`window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        (function () {
          var id = '${SITE.gaId}';
          var loaded = false;
          function load() {
            if (loaded) return;
            loaded = true;
            gtag('js', new Date());
            gtag('config', id);
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
          }
          // Keep third-party analytics off the critical path: load after the
          // page is idle (or on the first interaction, whichever comes first).
          function onIdle() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(load, { timeout: 2500 });
            } else {
              setTimeout(load, 2500);
            }
          }
          if (document.readyState === 'complete') onIdle();
          else addEventListener('load', onIdle, { once: true });
          addEventListener('pointerdown', load, { once: true });
        })();`}
      />
    )}

    <script is:inline>
      // Flag the true initial load (or a hard reload) so the CSS page-fade
      // starts before first paint and never doubles up with view transitions.
      {
        const nav = performance.getEntriesByType('navigation')[0]
        const reload = nav && nav.type === 'reload'
        if (sessionStorage.getItem('yt-nav') !== '1' || reload) {
          document.documentElement.classList.add('yt-first')
        }
        sessionStorage.setItem('yt-nav', '1')
      }
    </script>
  </head>
  <body {...stylex.attrs(shellStyles.body)}>
    <a {...stylex.attrs(shellStyles.skipLink)} href="#site-main">Skip to main content</a>

    <Header />

    <main id="site-main" {...mainAttrs} tabindex="-1">
      <slot />
      <div {...stylex.attrs(pageStyles.container)}>
        <SiteCta />
      </div>
    </main>

    <Footer />
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/mermaid.ts"></script>
  </body>
</html>
