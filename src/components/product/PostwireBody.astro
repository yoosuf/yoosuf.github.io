<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
</svg>

        
</div>

        
<h3 data-pm-hook="pm-problem-name" {...stylex.attrs(styles.pmProblemName)}>
{"Cloud sandboxes add coupling"}
</h3>

        
<p data-pm-hook="pm-problem-desc" {...stylex.attrs(styles.pmProblemDesc)}>
{"\n          Mailtrap, SendGrid, and phone-verification SaaS reduce the blast radius, but your local suite still depends on the network, API keys, account state, and a pricing tier.\n        "}
</p>

      
</li>

      
<li data-pm-hook="pm-problem" {...stylex.attrs(styles.pmProblem)}>

        
<div data-pm-hook="pm-problem-icon" {...stylex.attrs(styles.pmProblemIcon)}>

          
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="12" r="10"/>
<polyline points="12 6 12 12 16 14"/>
</svg>

        
</div>

        
<h3 data-pm-hook="pm-problem-name" {...stylex.attrs(styles.pmProblemName)}>
{"Classic catchers are email-only"}
</h3>

        
<p data-pm-hook="pm-problem-desc" {...stylex.attrs(styles.pmProblemDesc)}>
{"\n          MailHog and Mailpit are great SMTP catchers, but they stop at email. Modern auth testing needs SMS, OTP extraction, magic links, and clean wait APIs too.\n        "}
</p>

      
</li>

      
<li data-pm-hook="pm-problem" {...stylex.attrs(styles.pmProblem)}>

        
<div data-pm-hook="pm-problem-icon" {...stylex.attrs(styles.pmProblemIcon)}>

          
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<rect x="4" y="4" width="16" height="16" rx="2"/>
<rect x="9" y="9" width="6" height="6"/>
<path d="M15 2v2"/>
<path d="M15 20v2"/>
<path d="M2 15h2"/>
<path d="M2 9h2"/>
<path d="M20 15h2"/>
<path d="M20 9h2"/>
<path d="M9 2v2"/>
<path d="M9 20v2"/>
</svg>

        
</div>

        
<h3 data-pm-hook="pm-problem-name" {...stylex.attrs(styles.pmProblemName)}>
{"Agents hit a wall at OTPs"}
</h3>

        
<p data-pm-hook="pm-problem-desc" {...stylex.attrs(styles.pmProblemDesc)}>
{"\n          An autonomous agent can't casually read a phone or browse webmail like a patient human. It needs a native, structured channel for email and SMS.\n        "}
</p>

      
</li>

    
</ul>

  
</div>


</section>



