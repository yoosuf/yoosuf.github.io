---
import * as stylex from '@stylexjs/stylex'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import Icon from '../components/Icon.astro'
import { homeStyles } from '../components/ui/home.stylex'
import { pageStyles } from '../components/ui/page.stylex'
import { a11y, buttons, chips, kicker, pills, stat } from '../components/ui/primitives'
import { decodeEntities, ensureTrailingSlash, formatShortDate, readingTime, toISODate } from '../lib/utils'
import { SITE } from '../config'

const posts = (await getCollection('blog'))
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const recent = posts.slice(0, 5)
const [featured, ...more] = recent

const toolbox = [
  'LLMs & RAG',
  'AI agents',
  'Production AI',
  'Go',
  'Elixir',
  'Python · FastAPI',
  'TypeScript',
  'React',
  'Flutter',
]
const productCardAttrs = stylex.attrs(homeStyles.productCard)
const productTitleAttrs = stylex.attrs(homeStyles.productTitle)
const latestCardAttrs = stylex.attrs(homeStyles.latestCard)
const latestTitleAttrs = stylex.attrs(homeStyles.latestTitle)
const ctaBandAttrs = stylex.attrs(homeStyles.ctaBand)
---

<BaseLayout
  title="Yoosuf Mohamed — Systems Architect, AI Engineer & Technical Consultant"
  description={SITE.description}
  keywords="Yoosuf Mohamed, systems architect, AI engineer, LLM, RAG, Go, Elixir, FastAPI, Next.js, React, Flutter, Colombo Sri Lanka"
  canonical="/"
  imageAlt="Yoosuf Mohamed, systems architect and AI engineer."
>
  <article {...stylex.attrs(homeStyles.article, pageStyles.container)}>
      <section {...stylex.attrs(homeStyles.hero)} aria-labelledby="hero-heading">
        <div class="hero-glow" aria-hidden="true"></div>

        <p {...stylex.attrs(homeStyles.availPill)}>
          <span aria-hidden="true" {...stylex.attrs(homeStyles.pulseDotWrap)}>
            <span class="y-ping"></span>
            <span {...stylex.attrs(homeStyles.pulseDot)}></span>
          </span>
          Available for new projects
        </p>

        <h1
          id="hero-heading"
          {...stylex.attrs(homeStyles.headline)}
        >
          I build
          <span {...stylex.attrs(homeStyles.headlineStrong)}>
            <span {...stylex.attrs(homeStyles.headlineStrongText)}>AI systems</span>
            <svg
              aria-hidden="true"
              viewBox="0 0 132 10"
              preserveAspectRatio="none"
              {...stylex.attrs(homeStyles.underlineSquiggle)}
              style="opacity:0.7"
            >
              <path
                d="M2 7 C22 1, 42 9, 62 5 S 102 3, 130 6"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
              />
            </svg>
          </span>
          that businesses really depend on.
        </h1>

        <p {...stylex.attrs(homeStyles.lead)}>
          I'm Yoosuf Mohamed — systems architect and AI engineer in Colombo. I help startups
          and enterprises ship LLM/RAG products, AI automation, and full-stack platforms
          that go beyond the demo and scale reliably.
        </p>

        <div {...stylex.attrs(homeStyles.heroActions)}>
          <a
            href="https://cal.com/yoosuf"
            target="_blank"
            rel="noopener"
            {...stylex.attrs(buttons.primary)}
          >
            Book a call
          </a>
          <a href="/services/" {...stylex.attrs(buttons.secondary)}>
            Explore services
          </a>
          <a href="/about/" {...stylex.attrs(buttons.textLink)}>
            More about me →
          </a>
        </div>

        <dl {...stylex.attrs(homeStyles.stats)}>
          <div>
            <dt {...stylex.attrs(a11y.srOnly)}>Experience</dt>
            <dd {...stylex.attrs(stat.value)}>10+ years</dd>
            <dd {...stylex.attrs(stat.label)}>building for startups &amp; enterprises</dd>
          </div>
          <div>
            <dt {...stylex.attrs(a11y.srOnly)}>Focus</dt>
            <dd {...stylex.attrs(stat.value)}>AI-first</dd>
            <dd {...stylex.attrs(stat.label)}>LLM/RAG, automation, agent systems</dd>
          </div>
          <div>
            <dt {...stylex.attrs(a11y.srOnly)}>Location</dt>
            <dd {...stylex.attrs(stat.value)}>Colombo, LK</dd>
            <dd {...stylex.attrs(stat.label)}>working with teams worldwide</dd>
          </div>
        </dl>

        <div {...stylex.attrs(homeStyles.toolboxWrap)}>
          <p {...stylex.attrs(kicker.eyebrow)}>Toolbox</p>
          <ul {...stylex.attrs(homeStyles.toolboxList)}>
            {toolbox.map((tool) => (
              <li key={tool} {...stylex.attrs(chips.tech)}>
                {tool}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section {...stylex.attrs(homeStyles.section)} aria-labelledby="products-heading">
        <div {...stylex.attrs(homeStyles.sectionHeader)}>
          <h2 id="products-heading" {...stylex.attrs(kicker.eyebrow)}>
            Products & projects
          </h2>
          <a href="/pinemail/" {...stylex.attrs(homeStyles.sectionLink)}>
            About Pine Mail →
          </a>
        </div>

        <ul {...stylex.attrs(homeStyles.productGrid)}>
          <li>
            <a
              href="/pinemail/"
              class:list={['product-card', productCardAttrs.class]}
            >
              <span {...stylex.attrs(homeStyles.productIconRow)}>
                <span class="svc-icon-chip" aria-hidden="true">
                  <Icon name="mail" size={18} />
                </span>
                <span {...stylex.attrs(homeStyles.productTitleRow)}>
                  <span class:list={['y-product-title', productTitleAttrs.class]}>Pine Mail</span>
                  <span {...stylex.attrs(pills.accentBorder)}>Live</span>
                </span>
              </span>
              <span {...stylex.attrs(homeStyles.productDesc)}>
                Self-hosted email + SMS catcher for dev, CI, and AI agents. Catch OTPs, magic
                links, and 2FA codes without touching your real inbox.
              </span>
              <span {...stylex.attrs(homeStyles.productCta)}>
                View Pine Mail
                <Icon name="arrow-right" size={15} class="product-arrow" />
              </span>
            </a>
          </li>

          <li {...stylex.attrs(homeStyles.productCardStatic)}>
            <span {...stylex.attrs(homeStyles.productIconRow)}>
              <span class="svc-icon-chip" aria-hidden="true">
                <Icon name="brain" size={18} />
              </span>
              <span {...stylex.attrs(homeStyles.productTitleRow)}>
                <span {...stylex.attrs(homeStyles.productTitle)}>KeepAI</span>
                <span {...stylex.attrs(pills.neutral)}>In the works</span>
              </span>
            </span>
            <span {...stylex.attrs(homeStyles.productDesc)}>
              A memory layer for AI. Give agents and assistants durable context that carries
              across sessions — notes, decisions, and knowledge that actually stick.
            </span>
          </li>

          <li {...stylex.attrs(homeStyles.productCardStatic)}>
            <span {...stylex.attrs(homeStyles.productIconRow)}>
              <span class="svc-icon-chip" aria-hidden="true">
                <Icon name="message-square" size={18} />
              </span>
              <span {...stylex.attrs(homeStyles.productTitleRow)}>
                <span {...stylex.attrs(homeStyles.productTitle)}>Messenger DB Design</span>
                <span {...stylex.attrs(pills.neutral)}>Design study</span>
              </span>
            </span>
            <span {...stylex.attrs(homeStyles.productDesc)}>
              A database design study for a messaging product at scale — schema, partitioning,
              and delivery semantics for chat at millions of messages.
            </span>
          </li>
        </ul>
      </section>

      <section {...stylex.attrs(homeStyles.section)} aria-labelledby="recent-heading">
        <div {...stylex.attrs(homeStyles.sectionHeader)}>
          <h2 id="recent-heading" {...stylex.attrs(kicker.eyebrow)}>
            Recent posts
          </h2>
          <a href="/blog/" {...stylex.attrs(homeStyles.sectionLink)}>
            All posts →
          </a>
        </div>

        <a
          href={ensureTrailingSlash(featured.data.permalink)}
          class:list={['latest-wash', latestCardAttrs.class]}
        >
          <span {...stylex.attrs(homeStyles.latestBadgeRow)}>
            <span {...stylex.attrs(pills.accent)}>Latest</span>
            {featured.data.categories.slice(0, 2).map((category) => (
              <span key={category} {...stylex.attrs(pills.neutral)}>
                {category}
              </span>
            ))}
          </span>

          <span class:list={['y-latest-title', latestTitleAttrs.class]}>
            {decodeEntities(featured.data.title)}
          </span>

          <span {...stylex.attrs(homeStyles.latestDesc)}>
            {featured.data.description}
          </span>

          <span {...stylex.attrs(homeStyles.latestMeta)}>
            <time datetime={toISODate(featured.data.date)}>{formatShortDate(featured.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(featured.body)} min read</span>
          </span>
        </a>

        <ul {...stylex.attrs(homeStyles.postListFull)}>
          {more.map((post) => (
            <PostCard post={post} headingLevel="h3" />
          ))}
        </ul>
      </section>

      <section class:list={['cta-band', ctaBandAttrs.class]} aria-labelledby="cta-heading">
        <h2 id="cta-heading" {...stylex.attrs(homeStyles.ctaHeading)}>
          Let's build something that scales.
        </h2>
        <p {...stylex.attrs(homeStyles.ctaBody)}>
          Planning an AI product, automating a workflow, or taking a platform to production?
          I'd love to hear what you're building.
        </p>
        <div {...stylex.attrs(homeStyles.ctaActions)}>
          <a
            href="https://cal.com/yoosuf"
            target="_blank"
            rel="noopener"
            {...stylex.attrs(buttons.primary)}
          >
            Book a call
          </a>
          <a href="/contact/" {...stylex.attrs(buttons.secondary)}>
            Contact me
          </a>
        </div>
      </section>
  </article>
</BaseLayout>
