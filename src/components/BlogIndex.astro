---
import * as stylex from '@stylexjs/stylex'
import type { CollectionEntry } from 'astro:content'
import { Breadcrumbs } from './ui/Breadcrumbs'
import { pageStyles } from './ui/page.stylex'
import { blogStyles } from './ui/blog.stylex'
import { a11y } from './ui/primitives'
import PostCard from './PostCard.astro'
import { POSTS_PER_PAGE } from '../lib/pagination'
import { SITE } from '../config'

interface Props {
  posts: CollectionEntry<'blog'>[]
  currentPage: number
  totalPages: number
  totalPosts: number
  infinite?: boolean
}

const { posts, currentPage, totalPages, totalPosts, infinite = false } = Astro.props
const pageUrl = (n: number) => (n === 1 ? '/blog/' : `/blog/page/${n}/`)
const start = (currentPage - 1) * POSTS_PER_PAGE + 1
const end = start + posts.length - 1
const listAttrs = stylex.attrs(blogStyles.list)
---

<article {...stylex.attrs(pageStyles.page, pageStyles.container)}>
  <Breadcrumbs items={[{ label: 'Blog' }]} baseUrl={SITE.url} />

  <header {...stylex.attrs(pageStyles.header)}>
    <h1 {...stylex.attrs(pageStyles.title)}>
      Blog
    </h1>

    <p {...stylex.attrs(blogStyles.intro)}>
      Notes, thoughts, and deep dives on AI, systems architecture, and software engineering —
      from over a decade building products.
    </p>

    <p {...stylex.attrs(blogStyles.summary)} data-blog-summary>
      Showing {start}–{end} of {totalPosts} posts
    </p>
  </header>

  <ul
    {...listAttrs}
    class:list={['y-blog-list', listAttrs.class]}
    data-infinite-list
    data-total={totalPosts}
  >
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </ul>

  {infinite ? (
    <>
      <div
        {...stylex.attrs(blogStyles.sentinel)}
        data-infinite-sentinel
        data-next={currentPage + 1}
        data-last={totalPages}
        aria-hidden="true"
      ></div>

      <p {...stylex.attrs(a11y.srOnly)} data-infinite-status role="status"></p>

      {totalPages > 1 && (
        <div {...stylex.attrs(blogStyles.footerNav)}>
          <button
            type="button"
            data-infinite-button
            {...stylex.attrs(blogStyles.loadMore)}
          >
            Load more posts
          </button>

          <noscript>
            <div {...stylex.attrs(blogStyles.noscriptStack)}>
              {Array.from({ length: totalPages }, (_, i) => i + 2).map((n) => (
                <a href={pageUrl(n)} {...stylex.attrs(blogStyles.olderLink)}>
                  Older posts — page {n}
                </a>
              ))}
            </div>
          </noscript>
        </div>
      )}
    </>
  ) : (
    totalPages > 1 && (
      <nav aria-label="Blog pages" {...stylex.attrs(blogStyles.footerNav)}>
        <p {...stylex.attrs(blogStyles.pagerInfo)}>
          Page {currentPage} of {totalPages}
        </p>

        <ul {...stylex.attrs(blogStyles.pagerList)}>
          <li>
            {currentPage > 1 ? (
              <a href={pageUrl(currentPage - 1)} {...stylex.attrs(blogStyles.pageLink)} aria-label="Previous page">
                ←
              </a>
            ) : (
              <span {...stylex.attrs(blogStyles.pageLinkDisabled)} aria-hidden="true">
                ←
              </span>
            )}
          </li>

          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) =>
            n === currentPage ? (
              <li key={n}>
                <span aria-current="page" {...stylex.attrs(blogStyles.pageLinkCurrent)}>
                  {n}
                </span>
              </li>
            ) : (
              <li key={n}>
                <a href={pageUrl(n)} {...stylex.attrs(blogStyles.pageLink)}>
                  {n}
                </a>
              </li>
            ),
          )}

          <li>
            {currentPage < totalPages ? (
              <a href={pageUrl(currentPage + 1)} {...stylex.attrs(blogStyles.pageLink)} aria-label="Next page">
                →
              </a>
            ) : (
              <span {...stylex.attrs(blogStyles.pageLinkDisabled)} aria-hidden="true">
                →
              </span>
            )}
          </li>
        </ul>
      </nav>
    )
  )}
</article>

<script>
  import { initInfiniteScroll } from '../scripts/infiniteScroll'
  initInfiniteScroll()
</script>
