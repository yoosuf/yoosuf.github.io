---
import * as stylex from '@stylexjs/stylex'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import { Breadcrumbs } from '../components/ui/Breadcrumbs'
import { pageStyles } from '../components/ui/page.stylex'
import { postStyles } from '../components/ui/post.stylex'
import { kicker, pills } from '../components/ui/primitives'
import Icon from '../components/Icon.astro'
import PostCard from '../components/PostCard.astro'
import {
  decodeEntities,
  ensureTrailingSlash,
  formatShortDate,
  toISODate,
} from '../lib/utils'
import {
  buildToc,
  extractCitations,
  extractQuestions,
  postProse,
  readingMinutesOf,
  wordCountOf,
} from '../lib/answer'
import { SITE } from '../config'
import Paragraph from '../components/markdown/Paragraph.astro'
import Heading2 from '../components/markdown/Heading2.astro'
import Heading3 from '../components/markdown/Heading3.astro'
import Heading4 from '../components/markdown/Heading4.astro'
import UnorderedList from '../components/markdown/UnorderedList.astro'
import OrderedList from '../components/markdown/OrderedList.astro'
import ListItem from '../components/markdown/ListItem.astro'
import Link from '../components/markdown/Link.astro'
import Quote from '../components/markdown/Quote.astro'
import Code from '../components/markdown/Code.astro'
import Pre from '../components/markdown/Pre.astro'
import Rule from '../components/markdown/Rule.astro'
import Image from '../components/markdown/Image.astro'
import Video from '../components/markdown/Video.astro'
import Table from '../components/markdown/Table.astro'
import TableHead from '../components/markdown/TableHead.astro'
import TableBody from '../components/markdown/TableBody.astro'
import TableRow from '../components/markdown/TableRow.astro'
import TableCell from '../components/markdown/TableCell.astro'
import TableHeader from '../components/markdown/TableHeader.astro'
import Figure from '../components/markdown/Figure.astro'
import Caption from '../components/markdown/Caption.astro'
import Strong from '../components/markdown/Strong.astro'
import Kbd from '../components/markdown/Kbd.astro'

interface Props {
  entry: CollectionEntry<'blog'>
  newer?: CollectionEntry<'blog'> | null
  older?: CollectionEntry<'blog'> | null
  related?: CollectionEntry<'blog'>[]
}

const { entry, newer, older, related = [] } = Astro.props
const { Content, headings } = await render(entry)

const {
  title,
  subTitle,
  author,
  date,
  updated,
  description,
  categories,
  tags,
  permalink,
  seoTitle,
} = entry.data
const decodedTitle = decodeEntities(title)
const url = ensureTrailingSlash(permalink)
const absoluteUrl = new URL(url, SITE.url).href
// The page node and the article node are separate entities that reference each
// other. Sharing one id would collapse them into a single node and lose the
// page/article distinction that makes the graph navigable.
const webPageId = `${absoluteUrl}#webpage`
const breadcrumbId = `${absoluteUrl}#breadcrumb`

// `subTitle` is the standfirst the author wrote for this post; `description` is
// the one that already exists on all 41. Either way the reader gets the answer
// above the fold instead of only in the search snippet.
const dek = decodeEntities(subTitle ?? description ?? decodedTitle)

// Reading time and word count come from the prose a reader actually reads.
// Counting the MDX source inflated both — code fences, mermaid diagrams and
// front matter were all being counted as words.
const words = wordCountOf(postProse(entry.body))
const minutes = readingMinutesOf(words)

const isoDate = toISODate(date)
const isoUpdated = updated ? toISODate(updated) : null
const postImage = entry.data.heroImage
  ? new URL(entry.data.heroImage, SITE.url).href
  : new URL(SITE.socialImage, SITE.url).href
const postImageAlt = entry.data.heroAlt ?? decodedTitle
const proseAttrs = stylex.attrs(postStyles.prose)
const markdownComponents = {
  p: Paragraph, h2: Heading2, h3: Heading3, h4: Heading4, ul: UnorderedList, ol: OrderedList,
  li: ListItem, a: Link, blockquote: Quote, code: Code, pre: Pre, hr: Rule, img: Image, video: Video,
  table: Table, thead: TableHead, tbody: TableBody, tr: TableRow, td: TableCell, th: TableHeader,
  figure: Figure, figcaption: Caption, strong: Strong, kbd: Kbd,
}

const toc = buildToc(headings)
// A heading only becomes a Question when the paragraph under it really answers
// it, so a section that opens with a diagram is left out rather than published
// half-answered.
const questions = extractQuestions(entry.body)
const citations = extractCitations(entry.body, SITE.url)

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': absoluteUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': webPageId },
  url: absoluteUrl,
  headline: decodedTitle,
  ...(subTitle ? { alternativeHeadline: decodeEntities(subTitle) } : {}),
  description,
  image: {
    '@type': 'ImageObject',
    url: postImage,
    width: 1200,
    height: 630,
    caption: postImageAlt,
  },
  inLanguage: SITE.lang,
  datePublished: isoDate,
  dateModified: isoUpdated ?? isoDate,
  isAccessibleForFree: true,
  articleSection: categories[0] ?? 'Blog',
  keywords: tags.join(', '),
  wordCount: words,
  timeRequired: `PT${minutes}M`,
  isPartOf: [{ '@id': `${SITE.url}/blog/#blog` }, { '@id': `${SITE.url}/#website` }],
  about: { '@id': `${SITE.url}/#person` },
  breadcrumb: { '@id': breadcrumbId },
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#organization` },
  // What the post actually links to, published as its sources.
  ...(citations.length > 0
    ? {
        citation: citations.map((source) => ({
          '@type': 'CreativeWork',
          name: source.name,
          url: source.url,
        })),
      }
    : {}),
}

const faqJsonLd =
  questions.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${absoluteUrl}#faq`,
        isPartOf: { '@id': webPageId },
        mainEntity: questions.map((question) => ({
          '@type': 'Question',
          name: question.text,
          acceptedAnswer: { '@type': 'Answer', text: question.answer },
        })),
      }
    : null
---

<BaseLayout
  title={decodedTitle}
  metaTitle={seoTitle}
  description={description ?? decodedTitle}
  image={postImage}
  imageAlt={postImageAlt}
  canonical={url}
  type="article"
  mainEntity={absoluteUrl}
  breadcrumb={breadcrumbId}
  speakable={['[data-answer]']}
  jsonLd={[
    articleJsonLd,
    ...(faqJsonLd ? [faqJsonLd] : []),
    ...(related.length > 0
      ? [
          {
            '@context': 'https://schema.org',
            '@type': 'ItemList',
            '@id': `${absoluteUrl}#related`,
            name: 'Related reading',
            numberOfItems: related.length,
            itemListOrder: 'https://schema.org/ItemListUnordered',
            itemListElement: related.map((post, position) => ({
              '@type': 'ListItem',
              position: position + 1,
              url: new URL(ensureTrailingSlash(post.data.permalink), SITE.url).href,
              name: decodeEntities(post.data.title),
            })),
          },
        ]
      : []),
  ]}
  article={{
    published: isoDate,
    modified: isoUpdated ?? undefined,
    section: categories[0],
    tags,
  }}
>
  <article {...stylex.attrs(pageStyles.page, pageStyles.container)}>
      <Breadcrumbs
        id={breadcrumbId}
        items={[{ label: 'Blog', href: '/blog/' }, { label: decodedTitle }]}
        baseUrl={SITE.url}
      />

      <header {...stylex.attrs(pageStyles.header)}>
        {categories.length > 0 && (
          <p {...stylex.attrs(kicker.eyebrow)}>
            {categories[0]}
          </p>
        )}

        <h1 {...stylex.attrs(postStyles.title)}>
          {decodedTitle}
        </h1>

        <p {...stylex.attrs(postStyles.dek)} data-answer>
          {dek}
        </p>

        <p {...stylex.attrs(postStyles.meta)}>
          <time datetime={isoDate}>{formatShortDate(date)}</time>
          {isoUpdated && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated{' '}
                <time datetime={isoUpdated}>{formatShortDate(new Date(isoUpdated))}</time>
              </span>
            </>
          )}
          <span aria-hidden="true">&middot;</span>
          <span {...stylex.attrs(postStyles.metaItem)}>
            <Icon name="clock" size={13} />
            {minutes} min read
          </span>
        </p>

        <div {...stylex.attrs(postStyles.byline)}>
          <img
            {...stylex.attrs(postStyles.bylineAvatar)}
            src={SITE.logo}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
          />
          <span {...stylex.attrs(postStyles.bylineText)}>
            By{' '}
            <a {...stylex.attrs(postStyles.bylineName)} href="/yoosuf/">{author}</a>, Systems
            Architect
          </span>
        </div>
      </header>

      {toc.length >= 3 && (
        <nav {...stylex.attrs(postStyles.toc)} aria-labelledby="toc-title">
          <h2 id="toc-title" {...stylex.attrs(postStyles.tocTitle)}>On this page</h2>
          <ul {...stylex.attrs(postStyles.tocList)}>
            {toc.map((node) => (
              <li {...stylex.attrs(postStyles.tocItem)}>
                <a {...stylex.attrs(postStyles.tocLink)} href={`#${node.id}`}>{node.text}</a>
                {node.children.length > 0 && (
                  <ul {...stylex.attrs(postStyles.tocListSub)}>
                    {node.children.map((child) => (
                      <li {...stylex.attrs(postStyles.tocItem)}>
                        <a
                          {...stylex.attrs(postStyles.tocLink, postStyles.tocLinkSub)}
                          href={`#${child.id}`}
                        >
                          {child.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div {...proseAttrs}>
        <Content components={markdownComponents} />
      </div>

      {tags.length > 0 && (
        <footer {...stylex.attrs(postStyles.tags)}>
          <ul {...stylex.attrs(postStyles.tagList)} aria-label="Tags">
            {tags.map((tag) => (
              <li {...stylex.attrs(pills.tag)}>{tag}</li>
            ))}
          </ul>
        </footer>
      )}

      {related.length > 0 && (
        <section {...stylex.attrs(postStyles.related)} aria-labelledby="related-heading">
          <h2 id="related-heading" {...stylex.attrs(postStyles.relatedHeading)}>
            Related reading
          </h2>
          <ul {...stylex.attrs(postStyles.relatedList)}>
            {related.map((post) => (
              <PostCard post={post} headingLevel="h3" divider />
            ))}
          </ul>
        </section>
      )}

      {(newer || older) && (
        <nav {...stylex.attrs(postStyles.pager)} aria-label="Post navigation">
          {older && (
            <a
              href={ensureTrailingSlash(older.data.permalink)}
              data-home-hook="post-pager-link"
              {...stylex.attrs(postStyles.pagerLink, postStyles.pagerLinkOlder)}
            >
              <span {...stylex.attrs(postStyles.pagerLabel)}>← Older post</span>
              <span
                data-home-hook="post-pager-title"
                {...stylex.attrs(postStyles.pagerTitle)}
              >
                {decodeEntities(older.data.title)}
              </span>
            </a>
          )}
          {newer && (
            <a
              href={ensureTrailingSlash(newer.data.permalink)}
              data-home-hook="post-pager-link"
              {...stylex.attrs(postStyles.pagerLink, postStyles.pagerLinkNewer)}
            >
              <span {...stylex.attrs(postStyles.pagerLabel)}>Newer post →</span>
              <span
                data-home-hook="post-pager-title"
                {...stylex.attrs(postStyles.pagerTitle)}
              >
                {decodeEntities(newer.data.title)}
              </span>
            </a>
          )}
        </nav>
      )}
  </article>

</BaseLayout>
