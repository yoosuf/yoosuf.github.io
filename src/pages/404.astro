---
import BaseLayout from '../layouts/BaseLayout.astro'

export const prerender = true
---

<BaseLayout title="Page not found" canonical="" noIndex>
  <article class="site-container py-20 sm:py-28">
      <h1 class="text-4xl font-semibold tracking-[-0.02em] text-ink">404</h1>
      <p class="mt-4 max-w-[28rem] text-[0.975rem] leading-relaxed text-mid">
        The page you are looking for does not exist — or it has been moved.
      </p>
      <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[0.9rem]">
        <a href="/" class="text-accent no-underline hover:underline underline-offset-4">Home</a>
        <a href="/blog/" class="text-accent no-underline hover:underline underline-offset-4">Blog</a>
      </div>
    </article>
</BaseLayout>