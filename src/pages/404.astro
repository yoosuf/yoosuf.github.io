---
import * as stylex from '@stylexjs/stylex'
import BaseLayout from '../layouts/BaseLayout.astro'
import { notFoundStyles } from '../components/ui/notFound.stylex'
import { pageStyles } from '../components/ui/page.stylex'
import { buttons } from '../components/ui/primitives'

export const prerender = true
---

<BaseLayout title="Page not found" canonical="" noIndex>
  <article {...stylex.attrs(notFoundStyles.article, pageStyles.container)}>
    <h1 {...stylex.attrs(notFoundStyles.title)}>404</h1>
    <p {...stylex.attrs(notFoundStyles.lead)}>
      The page you are looking for does not exist — or it has been moved.
    </p>
    <div {...stylex.attrs(notFoundStyles.links)}>
      <a href="/" {...stylex.attrs(buttons.textLink)}>Home</a>
      <a href="/blog/" {...stylex.attrs(buttons.textLink)}>Blog</a>
    </div>
  </article>
</BaseLayout>
