<!-- Generated with npm run generate:postwire. Do not edit by hand. -->
<section data-pm-hook="pm-section pm-switch-section" {...stylex.attrs(styles.pmSection)}>

  
<div data-pm-hook="pm-container" {...stylex.attrs(styles.pmContainer)}>

    
<h2 data-pm-hook="pm-section-title" {...stylex.attrs(styles.pmSectionTitle)}>
{"Why developers switch to Postwire"}
</h2>

    
<p data-pm-hook="pm-section-sub" {...stylex.attrs(styles.pmSectionSub)}>
{"\n      It replaces the messy parts of auth testing with one local tool: email testing, SMS 2FA testing,\n      webhook capture, OTP extraction, and agent-readable APIs in the same process.\n    "}
</p>

    
<ul data-pm-hook="pm-switch-grid" {...stylex.attrs(styles.pmSwitchGrid)}>

      
<li data-pm-hook="pm-switch-card" {...stylex.attrs(styles.pmSwitchCard)}>

        
<p data-pm-hook="pm-switch-kicker" {...stylex.attrs(styles.pmSwitchKicker)}>
{"For local dev"}
</p>

        
<h3 data-pm-hook="pm-switch-title" {...stylex.attrs(styles.pmSwitchTitle)}>
{"A MailHog and Mailpit alternative that understands modern auth"}
</h3>

        
<p data-pm-hook="pm-switch-desc" {...stylex.attrs(styles.pmSwitchDesc)}>
{"\n          Catch SMTP like the classic tools, then go further: parse verification codes, magic links,\n          reset URLs, and SMS messages without asking your app or your browser to pretend.\n        "}
</p>

      
</li>

      
<li data-pm-hook="pm-switch-card" {...stylex.attrs(styles.pmSwitchCard)}>

        
<p data-pm-hook="pm-switch-kicker" {...stylex.attrs(styles.pmSwitchKicker)}>
{"For E2E and CI"}
</p>

        
<h3 data-pm-hook="pm-switch-title" {...stylex.attrs(styles.pmSwitchTitle)}>
{"Deterministic Playwright auth tests with zero "}
<code {...stylex.attrs(styles.pmInlineCode)}>
{"sleep()"}
</code>
</h3>

        
<p data-pm-hook="pm-switch-desc" {...stylex.attrs(styles.pmSwitchDesc)}>
{"\n          Long-polling waits return when the matching email or text arrives. Use "}
<code {...stylex.attrs(styles.pmInlineCode)}>
{"since"}
</code>
{",\n          assert the extracted code, clean the inbox, and keep the pipeline boring.\n        "}
</p>

      
</li>

      
<li data-pm-hook="pm-switch-card" {...stylex.attrs(styles.pmSwitchCard)}>

        
<p data-pm-hook="pm-switch-kicker" {...stylex.attrs(styles.pmSwitchKicker)}>
{"For AI agents"}
</p>

        
<h3 data-pm-hook="pm-switch-title" {...stylex.attrs(styles.pmSwitchTitle)}>
{"MCP-native email and SMS tools for full MFA flows"}
</h3>

        
<p data-pm-hook="pm-switch-desc" {...stylex.attrs(styles.pmSwitchDesc)}>
{"\n          Agents can wait for email, extract a link, wait for SMS, read the OTP, and finish login\n          through 14 structured MCP tools instead of screen-scraping webmail.\n        "}
</p>

      
</li>

    
</ul>

  
</div>


</section>



<section data-pm-hook="pm-section" {...stylex.attrs(styles.pmSection)} id="problem">

  
<div data-pm-hook="pm-container" {...stylex.attrs(styles.pmContainer)}>

    
<h2 data-pm-hook="pm-section-title" {...stylex.attrs(styles.pmSectionTitle)}>
{"The problem: auth testing is still too fragile"}
</h2>

    
<p data-pm-hook="pm-section-sub" {...stylex.attrs(styles.pmSectionSub)}>
{"\n      Your test suite signs up a user. The app sends an email verification code, then a text-message 2FA code.\n      The whole thing should take seconds, but it often turns into waits, retries, inbox scraping, and one very suspicious timeout.\n    "}
</p>

    
<ul data-pm-hook="pm-problems" {...stylex.attrs(styles.pmProblems)}>

      
<li data-pm-hook="pm-problem" {...stylex.attrs(styles.pmProblem)}>

        
