---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Icon from '../components/Icon.astro'
import {
  decodeEntities,
  ensureTrailingSlash,
  formatShortDate,
  readingTime,
  toISODate,
} from '../lib/utils'
import { SITE } from '../config'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const { Content } = await render(entry)

const { title, date, description, categories, tags, permalink } = entry.data
const decodedTitle = decodeEntities(title)
const url = ensureTrailingSlash(permalink)
const absoluteUrl = new URL(url, SITE.url).href
const minutes = readingTime(entry.body)
const words = entry.body.trim().split(/\s+/).length
const isoDate = toISODate(date)
const mermaid = /```mermaid/.test(entry.body)
const postImage = entry.data.heroImage
  ? new URL(entry.data.heroImage, SITE.url).href
  : new URL(SITE.socialImage, SITE.url).href
const postImageAlt = entry.data.heroAlt ?? decodedTitle

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': absoluteUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': absoluteUrl },
  headline: decodedTitle,
  description,
  image: postImage,
  inLanguage: 'en',
  datePublished: isoDate,
  dateModified: isoDate,
  articleSection: categories[0] ?? 'Blog',
  keywords: tags.join(','),
  wordCount: words,
  timeRequired: `PT${minutes}M`,
  author: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: 'Yoosuf Mohamed',
    url: `${SITE.url}/about/`,
    image: new URL(SITE.logo, SITE.url).href,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.title,
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL(SITE.logoMark, SITE.url).href,
      width: 512,
      height: 512,
    },
  },
}
---

<BaseLayout
  title={decodedTitle}
  description={description ?? decodedTitle}
  image={postImage}
  imageAlt={postImageAlt}
  canonical={url}
  type="article"
  jsonLd={[articleJsonLd]}
  article={{
    published: isoDate,
    section: categories[0],
    tags,
  }}
>
  <article class="site-container py-14 sm:py-20">
      <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: decodedTitle }]} />

      <header class="mt-8">
        {categories.length > 0 && (
          <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-sub">
            {categories[0]}
          </p>
        )}

        <h1 class="mt-2 text-[2rem] sm:text-[2.6rem] font-semibold tracking-[-0.025em] leading-snug text-ink">
          {decodedTitle}
        </h1>

        <p class="mt-4 flex flex-wrap items-center gap-1.5 text-[0.825rem] text-sub">
          <time datetime={isoDate}>{formatShortDate(date)}</time>
          <span aria-hidden="true">&middot;</span>
          <span class="inline-flex items-center gap-1">
            <Icon name="clock" size={13} />
            {minutes} min read
          </span>
        </p>
      </header>

      <div class="prose mt-10">
        <Content />
      </div>

      {tags.length > 0 && (
        <footer class="mt-12 border-t border-line pt-6">
          <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
            {tags.map((tag) => (
              <li class="rounded border border-line px-2 py-0.5 text-[0.725rem] text-sub">{tag}</li>
            ))}
          </ul>
        </footer>
      )}
  </article>

  {mermaid && (
    <script>
      // Mermaid is heavy (~1MB); defer the download until the page is idle so
      // it never competes with the initial paint.
      const render = () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"]')
        if (!blocks.length) return
        import('mermaid').then(({ default: mermaid }) => {
          mermaid.initialize({ startOnLoad: false, theme: 'default' })
          blocks.forEach((pre, i) => {
            const div = document.createElement('div')
            div.className = 'mermaid'
            div.id = 'mermaid-' + i
            div.textContent = pre.textContent
            pre.replaceWith(div)
          })
          mermaid.run({ nodes: document.querySelectorAll('.mermaid') })
        })
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(render, { timeout: 3000 })
      } else {
        setTimeout(render, 1500)
      }
    </script>
  )}
</BaseLayout>