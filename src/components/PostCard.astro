---
import * as stylex from '@stylexjs/stylex'
import type { CollectionEntry } from 'astro:content'
import { postCardStyles } from './ui/postCard.stylex'
import { kicker } from './ui/primitives'
import { decodeEntities, ensureTrailingSlash, formatShortDate, readingTime, toISODate } from '../lib/utils'

interface Props {
  post: CollectionEntry<'blog'>
  headingLevel?: 'h2' | 'h3'
}

const { post, headingLevel = 'h2' } = Astro.props
const { title, date, description, permalink } = post.data
const url = ensureTrailingSlash(permalink)
const HeadingTag = headingLevel
const rowAttrs = stylex.attrs(postCardStyles.row)
const dateAttrs = stylex.attrs(kicker.date)
const headingAttrs = stylex.attrs(postCardStyles.heading)
const titleAttrs = stylex.attrs(postCardStyles.titleLink)
---

<li {...rowAttrs} class:list={['y-post-card', rowAttrs.class]}>
  <time {...dateAttrs} class:list={['y-post-date', dateAttrs.class]} datetime={toISODate(date)}>
    {formatShortDate(date)}
  </time>

  <HeadingTag {...headingAttrs} class:list={['y-post-heading', headingAttrs.class]}>
    <a href={url} {...titleAttrs} class:list={['y-post-title', titleAttrs.class]}>
      {decodeEntities(title)}
    </a>
  </HeadingTag>

  {description && (
    <p {...stylex.attrs(postCardStyles.desc)}>
      {description}
    </p>
  )}
</li>
