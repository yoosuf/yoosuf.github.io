---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductLayout from '../layouts/ProductLayout.astro'
import PinemailBody from '../components/product/PinemailBody.astro'
import * as stylex from '@stylexjs/stylex'
import { styles } from '../components/ui/product.stylex'
import { pinemail } from '../data/product'
import { SITE } from '../config'


const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Pine Mail',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description:
    'A free, open-source local auth testing tool for email OTPs, magic links, password resets, SMS 2FA, Playwright tests, CI pipelines, and autonomous AI agents. Single Rust binary with SMTP and SMS catching, Twilio webhook ingestion, long-polling APIs, automatic signal extraction, and a native MCP server with 14 tools.',
  url: `${SITE.url}/pinemail/`,
  image: `${SITE.url}/assets/images/pinemail-og.png`,
  softwareVersion: '0.2.0',
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Dual-channel SMTP & SMS catching',
    'Local auth testing for email OTPs, magic links, password resets, and SMS 2FA',
    'Email long-polling (GET /api/wait) and SMS long-polling (GET /api/sms/wait)',
    'Twilio webhook ingestion (POST /api/sms/webhook)',
    'Automatic OTP and URL extraction for email and SMS',
    'Litmus-style email analysis with heuristic spam score',
    'Native Model Context Protocol (MCP) server with 14 tools for AI agents',
    'Embedded dual-tab web dashboard with live WebSocket updates',
    'REST API with SQLite storage',
    'Single static binary under 15MB',
    'In-memory database mode for CI',
  ],
  downloadUrl: 'https://github.com/yoosuf/pinemail',
  codeRepository: 'https://github.com/yoosuf/pinemail',
  author: { '@type': 'Person', name: 'Yoosuf Mohamed', url: SITE.url },
  publisher: { '@type': 'Person', name: 'Yoosuf Mohamed', url: SITE.url },
  sameAs: [
    'https://github.com/yoosuf/pinemail',
    'https://hub.docker.com/r/yoosuf/pinemail',
    'https://www.producthunt.com/products/pinemail',
    `${SITE.url}/blog/introducing-pinemail`,
    `${SITE.url}/blog/pinemail-sms-mcp-analysis`,
  ],
}
---

<BaseLayout
  title={pinemail.seo.title}
  description={pinemail.seo.description}
  image={pinemail.seo.image}
  imageAlt={pinemail.seo.imageAlt}
  keywords={pinemail.seo.keywords}
  canonical={pinemail.seo.canonical}
  type="softwareApplication"
  jsonLd={[softwareJsonLd]}
>
  <ProductLayout product={pinemail}>
    <div slot="media">
      <div data-pm-hook="pm-terminal" {...stylex.attrs(styles.pmTerminal)} role="img" aria-label="Pine Mail quickstart in a terminal">
        <div data-pm-hook="pm-terminal-bar" {...stylex.attrs(styles.pmTerminalBar)}>
          <span data-pm-hook="pm-terminal-dot pm-terminal-dot-red" {...stylex.attrs(styles.pmTerminalDotRed)}></span>
          <span data-pm-hook="pm-terminal-dot pm-terminal-dot-yellow" {...stylex.attrs(styles.pmTerminalDotYellow)}></span>
          <span data-pm-hook="pm-terminal-dot pm-terminal-dot-green" {...stylex.attrs(styles.pmTerminalDotGreen)}></span>
          <span data-pm-hook="pm-terminal-title" {...stylex.attrs(styles.pmTerminalTitle)}>pinemail — zsh</span>
        </div>
        <div data-pm-hook="pm-terminal-body" {...stylex.attrs(styles.pmTerminalBody)}>
          <pre data-pm-hook="pm-terminal-lines" {...stylex.attrs(styles.pmTerminalLines)}><span data-pm-hook="pm-prompt" {...stylex.attrs(styles.pmPrompt)}>$</span> docker run -d --name pinemail \
    -p 1025:1025 -p 8025:8025 yoosuf/pinemail:latest

<span data-pm-hook="pm-prompt" {...stylex.attrs(styles.pmPrompt)}>$</span> curl "http://localhost:8025/api/wait?to=user@example.com&timeout_ms=10000"
&#123;
  "id": "msg_01J6XYZ",
  "subject": "Confirm your account",
  "codes": ["849201"]
&#125;

<span data-pm-hook="pm-prompt" {...stylex.attrs(styles.pmPrompt)}>$</span> curl -X POST http://localhost:8025/api/sms/webhook \
    -d "From=%2B15550199&To=%2B15550100&Body=Your code is 839201"
<span data-pm-hook="pm-ok" {...stylex.attrs(styles.pmOk)}>&#10003;</span> sms_01A2B3 captured in 3ms</pre>
        </div>
      </div>
    </div>

    <!-- Body sections: builtfor → faq. Rendered via the generated StyleX component. -->
    <PinemailBody />

    <script src="../scripts/pinemail.ts"></script>
  </ProductLayout>
</BaseLayout>
