---
import * as stylex from '@stylexjs/stylex'
import { SITE } from '../config'
import { footerStyles } from './footer.stylex'
import { a11y } from './ui/primitives'

const year = SITE.date.currentYear
---

<footer transition:persist {...stylex.attrs(footerStyles.bar)}>
  <div {...stylex.attrs(footerStyles.container)}>
    <div {...stylex.attrs(footerStyles.row)}>
      <p {...stylex.attrs(footerStyles.legal)}>
        © 2007–{year} <a href="/" {...stylex.attrs(footerStyles.brandLink)}>{SITE.title}</a>.
        <span {...stylex.attrs(footerStyles.sep)} aria-hidden>&middot;</span>
        <a {...stylex.attrs(footerStyles.legalLink)} href="/terms/">Terms</a>
        <span {...stylex.attrs(footerStyles.sep)} aria-hidden>&middot;</span>
        <a {...stylex.attrs(footerStyles.legalLink)} href="/privacy/">Privacy</a>
      </p>

      <nav {...stylex.attrs(footerStyles.nav)} aria-label="Footer">
        <a {...stylex.attrs(footerStyles.navLink)} href="/feed.xml">RSS</a>
        <a {...stylex.attrs(footerStyles.navLink)} href={`mailto:${SITE.email}`}>Email</a>
        <a {...stylex.attrs(footerStyles.navLink)} href="https://twitter.com/aitchdei" target="_blank" rel="noopener">
          X <span {...stylex.attrs(a11y.srOnly)}>(opens in new tab)</span>
        </a>
        <a {...stylex.attrs(footerStyles.navLink)} href="https://github.com/yoosuf" target="_blank" rel="noopener">
          GitHub <span {...stylex.attrs(a11y.srOnly)}>(opens in new tab)</span>
        </a>
        <a {...stylex.attrs(footerStyles.navLink)} href="https://www.linkedin.com/in/yoosufm" target="_blank" rel="noopener">
          LinkedIn <span {...stylex.attrs(a11y.srOnly)}>(opens in new tab)</span>
        </a>
      </nav>
    </div>
  </div>
</footer>