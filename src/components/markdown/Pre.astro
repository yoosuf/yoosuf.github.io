---
import * as stylex from '@stylexjs/stylex'
import MarkdownElement from './MarkdownElement.astro'
import { mermaidDiagramStyles } from '../diagrams/MermaidDiagram.stylex'
const { style: _style, ...attrs } = Astro.props
const isMermaid = attrs['data-language'] === 'mermaid'
const mermaidSurfaceAttrs = isMermaid
  ? stylex.attrs(mermaidDiagramStyles.surface, mermaidDiagramStyles.pencil)
  : {}
const mermaidTargetAttrs = isMermaid
  ? stylex.attrs(mermaidDiagramStyles.target, mermaidDiagramStyles.defaultSize, mermaidDiagramStyles.pending)
  : {}
const mermaidReadyAttrs = isMermaid ? stylex.attrs(mermaidDiagramStyles.ready) : {}
const mermaidErrorAttrs = isMermaid ? stylex.attrs(mermaidDiagramStyles.error) : {}
const forwarded = isMermaid
  ? {
      ...attrs,
      ...mermaidSurfaceAttrs,
      ...mermaidTargetAttrs,
      'data-mermaid-target': true,
      'data-mermaid-variant': 'pencil',
      'data-mermaid-id': 'mermaid-markdown',
      'data-mermaid-state': 'pending',
      'data-mermaid-pending-class': mermaidTargetAttrs.class,
      'data-mermaid-ready-class': mermaidReadyAttrs.class,
      'data-mermaid-error-class': mermaidErrorAttrs.class,
    }
  : attrs
---
<MarkdownElement tag="pre" {...forwarded}><slot /></MarkdownElement>
