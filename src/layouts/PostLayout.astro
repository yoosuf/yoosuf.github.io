---
import * as stylex from '@stylexjs/stylex'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import { Breadcrumbs } from '../components/ui/Breadcrumbs'
import { pageStyles } from '../components/ui/page.stylex'
import { postStyles } from '../components/ui/post.stylex'
import { kicker, pills } from '../components/ui/primitives'
import Icon from '../components/Icon.astro'
import {
  decodeEntities,
  ensureTrailingSlash,
  formatShortDate,
  readingTime,
  toISODate,
} from '../lib/utils'
import { SITE } from '../config'
import Paragraph from '../components/markdown/Paragraph.astro'
import Heading2 from '../components/markdown/Heading2.astro'
import Heading3 from '../components/markdown/Heading3.astro'
import Heading4 from '../components/markdown/Heading4.astro'
import UnorderedList from '../components/markdown/UnorderedList.astro'
import OrderedList from '../components/markdown/OrderedList.astro'
import ListItem from '../components/markdown/ListItem.astro'
import Link from '../components/markdown/Link.astro'
import Quote from '../components/markdown/Quote.astro'
import Code from '../components/markdown/Code.astro'
import Pre from '../components/markdown/Pre.astro'
import Rule from '../components/markdown/Rule.astro'
import Image from '../components/markdown/Image.astro'
import Video from '../components/markdown/Video.astro'
import Table from '../components/markdown/Table.astro'
import TableHead from '../components/markdown/TableHead.astro'
import TableBody from '../components/markdown/TableBody.astro'
import TableRow from '../components/markdown/TableRow.astro'
import TableCell from '../components/markdown/TableCell.astro'
import TableHeader from '../components/markdown/TableHeader.astro'
import Figure from '../components/markdown/Figure.astro'
import Caption from '../components/markdown/Caption.astro'
import Strong from '../components/markdown/Strong.astro'
import Kbd from '../components/markdown/Kbd.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const { Content } = await render(entry)

const { title, date, description, categories, tags, permalink } = entry.data
const decodedTitle = decodeEntities(title)
const url = ensureTrailingSlash(permalink)
const absoluteUrl = new URL(url, SITE.url).href
const minutes = readingTime(entry.body)
const words = entry.body.trim().split(/\s+/).length
const isoDate = toISODate(date)
const postImage = entry.data.heroImage
  ? new URL(entry.data.heroImage, SITE.url).href
  : new URL(SITE.socialImage, SITE.url).href
const postImageAlt = entry.data.heroAlt ?? decodedTitle
const proseAttrs = stylex.attrs(postStyles.prose)
const markdownComponents = {
  p: Paragraph, h2: Heading2, h3: Heading3, h4: Heading4, ul: UnorderedList, ol: OrderedList,
  li: ListItem, a: Link, blockquote: Quote, code: Code, pre: Pre, hr: Rule, img: Image, video: Video,
  table: Table, thead: TableHead, tbody: TableBody, tr: TableRow, td: TableCell, th: TableHeader,
  figure: Figure, figcaption: Caption, strong: Strong, kbd: Kbd,
}

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': absoluteUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': absoluteUrl },
  headline: decodedTitle,
  description,
  image: postImage,
  inLanguage: 'en',
  datePublished: isoDate,
  dateModified: isoDate,
  articleSection: categories[0] ?? 'Blog',
  keywords: tags.join(','),
  wordCount: words,
  timeRequired: `PT${minutes}M`,
  author: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: 'Yoosuf Mohamed',
    url: `${SITE.url}/about/`,
    image: new URL(SITE.logo, SITE.url).href,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.title,
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL(SITE.logoMark, SITE.url).href,
      width: 512,
      height: 512,
    },
  },
}
---

<BaseLayout
  title={decodedTitle}
  description={description ?? decodedTitle}
  image={postImage}
  imageAlt={postImageAlt}
  canonical={url}
  type="article"
  jsonLd={[articleJsonLd]}
  article={{
    published: isoDate,
    section: categories[0],
    tags,
  }}
>
  <article {...stylex.attrs(pageStyles.page, pageStyles.container)}>
      <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: decodedTitle }]} baseUrl={SITE.url} />

      <header {...stylex.attrs(pageStyles.header)}>
        {categories.length > 0 && (
          <p {...stylex.attrs(kicker.eyebrow)}>
            {categories[0]}
          </p>
        )}

        <h1 {...stylex.attrs(postStyles.title)}>
          {decodedTitle}
        </h1>

        <p {...stylex.attrs(postStyles.meta)}>
          <time datetime={isoDate}>{formatShortDate(date)}</time>
          <span aria-hidden="true">&middot;</span>
          <span {...stylex.attrs(postStyles.metaItem)}>
            <Icon name="clock" size={13} />
            {minutes} min read
          </span>
        </p>
      </header>

      <div {...proseAttrs}>
        <Content components={markdownComponents} />
      </div>

      {tags.length > 0 && (
        <footer {...stylex.attrs(postStyles.tags)}>
          <ul {...stylex.attrs(postStyles.tagList)} aria-label="Tags">
            {tags.map((tag) => (
              <li {...stylex.attrs(pills.tag)}>{tag}</li>
            ))}
          </ul>
        </footer>
      )}
  </article>

</BaseLayout>
