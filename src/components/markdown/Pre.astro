---
import * as stylex from '@stylexjs/stylex'
import MarkdownElement from './MarkdownElement.astro'
import { mermaidDiagramStyles } from '../diagrams/MermaidDiagram.stylex'
const { style: _style, ...attrs } = Astro.props
const isMermaid = attrs['data-language'] === 'mermaid'
// One merged class for the whole pre so the always-on chrome (surface box,
// pencil surface, flex centering, min-height) is never clobbered by the
// state class. The pending atom is baked in so the raw highlighted source
// stays invisible until mermaid mounts; the renderer only swaps the
// state atoms (pending -> ready/error) via classList, and `surface` keeps
// `overflow-x: auto` to contain the wide source pre-render.
const mermaidStaticClass = isMermaid
  ? stylex.attrs(
      mermaidDiagramStyles.surface,
      mermaidDiagramStyles.pencil,
      mermaidDiagramStyles.target,
      mermaidDiagramStyles.defaultSize,
      mermaidDiagramStyles.pending,
    ).class
  : undefined
const mermaidPendingClass = isMermaid ? stylex.attrs(mermaidDiagramStyles.pending).class : undefined
const mermaidReadyClass = isMermaid ? stylex.attrs(mermaidDiagramStyles.ready).class : undefined
const mermaidErrorClass = isMermaid ? stylex.attrs(mermaidDiagramStyles.error).class : undefined
const forwarded = isMermaid
  ? {
      ...attrs,
      class: mermaidStaticClass,
      'data-mermaid-target': true,
      'data-mermaid-variant': 'pencil',
      'data-mermaid-id': 'mermaid-markdown',
      'data-mermaid-state': 'pending',
      'data-mermaid-pending-class': mermaidPendingClass,
      'data-mermaid-ready-class': mermaidReadyClass,
      'data-mermaid-error-class': mermaidErrorClass,
    }
  : attrs
---
<MarkdownElement tag="pre" {...forwarded}><slot /></MarkdownElement>
