---
import * as stylex from '@stylexjs/stylex'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import { Breadcrumbs } from '../components/ui/Breadcrumbs'
import { pageStyles } from '../components/ui/page.stylex'
import { postStyles } from '../components/ui/post.stylex'
import { kicker, pills } from '../components/ui/primitives'
import Icon from '../components/Icon.astro'
import {
  decodeEntities,
  ensureTrailingSlash,
  formatShortDate,
  readingTime,
  toISODate,
} from '../lib/utils'
import { SITE } from '../config'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const { Content } = await render(entry)

const { title, date, description, categories, tags, permalink } = entry.data
const decodedTitle = decodeEntities(title)
const url = ensureTrailingSlash(permalink)
const absoluteUrl = new URL(url, SITE.url).href
const minutes = readingTime(entry.body)
const words = entry.body.trim().split(/\s+/).length
const isoDate = toISODate(date)
const mermaid = /```mermaid/.test(entry.body)
const postImage = entry.data.heroImage
  ? new URL(entry.data.heroImage, SITE.url).href
  : new URL(SITE.socialImage, SITE.url).href
const postImageAlt = entry.data.heroAlt ?? decodedTitle
const proseAttrs = stylex.attrs(postStyles.prose)

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': absoluteUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': absoluteUrl },
  headline: decodedTitle,
  description,
  image: postImage,
  inLanguage: 'en',
  datePublished: isoDate,
  dateModified: isoDate,
  articleSection: categories[0] ?? 'Blog',
  keywords: tags.join(','),
  wordCount: words,
  timeRequired: `PT${minutes}M`,
  author: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: 'Yoosuf Mohamed',
    url: `${SITE.url}/about/`,
    image: new URL(SITE.logo, SITE.url).href,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.title,
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL(SITE.logoMark, SITE.url).href,
      width: 512,
      height: 512,
    },
  },
}
---

<BaseLayout
  title={decodedTitle}
  description={description ?? decodedTitle}
  image={postImage}
  imageAlt={postImageAlt}
  canonical={url}
  type="article"
  jsonLd={[articleJsonLd]}
  article={{
    published: isoDate,
    section: categories[0],
    tags,
  }}
>
  <article {...stylex.attrs(pageStyles.page, pageStyles.container)}>
      <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: decodedTitle }]} baseUrl={SITE.url} />

      <header {...stylex.attrs(pageStyles.header)}>
        {categories.length > 0 && (
          <p {...stylex.attrs(kicker.eyebrow)}>
            {categories[0]}
          </p>
        )}

        <h1 {...stylex.attrs(postStyles.title)}>
          {decodedTitle}
        </h1>

        <p {...stylex.attrs(postStyles.meta)}>
          <time datetime={isoDate}>{formatShortDate(date)}</time>
          <span aria-hidden="true">&middot;</span>
          <span {...stylex.attrs(postStyles.metaItem)}>
            <Icon name="clock" size={13} />
            {minutes} min read
          </span>
        </p>
      </header>

      <div {...proseAttrs} class:list={['prose', proseAttrs.class]}>
        <Content />
      </div>

      {tags.length > 0 && (
        <footer {...stylex.attrs(postStyles.tags)}>
          <ul {...stylex.attrs(postStyles.tagList)} aria-label="Tags">
            {tags.map((tag) => (
              <li {...stylex.attrs(pills.tag)}>{tag}</li>
            ))}
          </ul>
        </footer>
      )}
  </article>

  {mermaid && (
    <script>
      // Mermaid is heavy (~1MB); defer the download until the page is idle so
      // it never competes with the initial paint.
      const render = () => {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"]')
        if (!blocks.length) return
        import('mermaid').then(({ default: mermaid }) => {
          mermaid.initialize({ startOnLoad: false, theme: 'default' })
          blocks.forEach((pre, i) => {
            const div = document.createElement('div')
            div.className = 'mermaid'
            div.id = 'mermaid-' + i
            div.textContent = pre.textContent
            pre.replaceWith(div)
          })
          mermaid.run({ nodes: document.querySelectorAll('.mermaid') })
        })
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(render, { timeout: 3000 })
      } else {
        setTimeout(render, 1500)
      }
    </script>
  )}
</BaseLayout>
