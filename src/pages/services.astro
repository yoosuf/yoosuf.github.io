---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import EngagementPricing from '../components/EngagementPricing.astro'
---

<BaseLayout
  title="Services — Yoosuf Mohamed"
  description="Consulting, architecture audits, AI integration, product development, and fractional tech leadership — scoped in writing and delivered by Yoosuf Mohamed."
  canonical="/services/"
>
  <article class="site-container py-14 sm:py-20">
      <Breadcrumbs items={[{ label: 'Services' }]} />

      <header class="mt-8">
        <h1 class="text-[2rem] sm:text-[2.4rem] font-semibold tracking-[-0.025em] leading-snug text-ink">
          Services
        </h1>
      </header>

      <div class="mt-10">
        <EngagementPricing />
      </div>
    </article>
</BaseLayout>