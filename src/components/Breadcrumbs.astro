---
import { SITE } from '../config'

interface Crumb {
  label: string
  href?: string
}

interface Props {
  items: Crumb[]
}

const { items } = Astro.props
const trail: { label: string; href?: string }[] = [
  { label: 'Home', href: `${SITE.url}/` },
  ...items,
]
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    ...(crumb.href ? { item: crumb.href } : {}),
  })),
}
---

<nav class="text-[0.8rem] text-faint" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    {trail.map((crumb, i) => (
      <li class="flex items-center gap-2">
        {crumb.href ? (
          <a href={crumb.href} class="no-underline hover:text-ink hover:underline underline-offset-4 decoration-line">
            {crumb.label}
          </a>
        ) : (
          <span aria-current="page" class="text-sub">{crumb.label}</span>
        )}
        {i < trail.length - 1 && <span aria-hidden="true">&rsaquo;</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />