---
import * as stylex from '@stylexjs/stylex'
import { styles } from '../components/ui/product.stylex'
import { SITE } from '../config'
import type { Product, ProductAction } from '../data/product'

interface Props {
  product: Product
}

const { product } = Astro.props

/* Theme primitives: products share the site accent; the derived light-dark()
   pairs follow the tokens in tokens.stylex.ts and the --color-* custom
   properties in global.css. Applied as a single inline style so both the
   StyleX atomics (var(--pm-*) refs) and the JS hooks (getComputedStyle reads)
   see the same values. */
const accentCss = product.accent
  ? `--pm-accent-light: ${product.accent.accent ?? '#2563eb'};` +
    `--pm-accent-strong-light: ${product.accent.accentStrong ?? '#1d4ed8'};` +
    `--pm-accent-deep-light: ${product.accent.accentDeep ?? '#1e40af'};` +
    `--pm-accent-soft-light: ${product.accent.accentSoft ?? '#e9effd'};` +
    `--pm-on-accent-light: ${product.accent.onAccent ?? '#ffffff'};`
  : ''

const themeCss =
  accentCss +
  `--pm-accent: light-dark(var(--pm-accent-light), color-mix(in srgb, var(--pm-accent-light) 68%, #fff));` +
  `--pm-accent-strong: light-dark(var(--pm-accent-strong-light), color-mix(in srgb, var(--pm-accent-light) 56%, #fff));` +
  `--pm-accent-deep: light-dark(var(--pm-accent-deep-light), color-mix(in srgb, var(--pm-accent-light) 42%, #fff));` +
  `--pm-accent-soft: light-dark(var(--pm-accent-soft-light), color-mix(in srgb, var(--pm-accent-light) 16%, transparent));` +
  `--pm-on-accent: light-dark(var(--pm-on-accent-light), #1a1a1a);` +
  `--pm-accent-glow: light-dark(color-mix(in srgb, var(--pm-accent-light) 30%, transparent), color-mix(in srgb, var(--pm-accent-light) 26%, transparent));` +
  `--pm-ink: light-dark(#1a1a1a, #e6e6e6);` +
  `--pm-ink-soft: light-dark(#5e5e5e, #979797);` +
  `--pm-ink-faint: light-dark(#747474, #7f7f7f);` +
  `--pm-surface: light-dark(#ffffff, #0e0e0e);` +
  `--pm-bg-soft: light-dark(#f6f6f6, #171717);` +
  `--pm-border: light-dark(#e5e5e5, #2b2b2b);` +
  `--pm-border-strong: light-dark(rgba(26, 26, 26, 0.3), rgba(230, 230, 230, 0.3));` +
  `--pm-band: light-dark(#161616, #0e0e0e);` +
  `--pm-nav-bg: light-dark(rgba(255, 255, 255, 0.92), rgba(14, 14, 14, 0.88));` +
  `--pm-wash-base: light-dark(#ffffff, transparent);` +
  `--pm-logo-chip: light-dark(#f6f6f6, #ffffff);` +
  `--pm-shadow-card: light-dark(0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 12px -2px rgba(0, 0, 0, 0.06)), light-dark(0 1px 2px rgba(0, 0, 0, 0.4), 0 4px 12px -2px rgba(0, 0, 0, 0.5));` +
  `--pm-shadow-lift: light-dark(rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0.55));` +
  `--pm-shadow-accent: light-dark(0 1px 2px rgba(37, 99, 235, 0.22), 0 1px 2px rgba(0, 0, 0, 0.3));` +
  `--pm-term-bg: #101010;` +
  `--pm-term-text: #d6d6d6;` +
  `--pm-term-prompt: #e6e6e6;` +
  `--pm-term-ok: #3fb950;` +
  `--pm-fs-hero: clamp(2.2rem, 3.6vw, 3rem);` +
  `--pm-fs-display: 1.7rem;` +
  `--pm-fs-lead: 1.05rem;` +
  `--pm-fs-title: 1.1rem;` +
  `--pm-fs-card: 1.05rem;` +
  `--pm-fs-feature: 1.25rem;` +
  `--pm-fs-body: 1rem;` +
  `--pm-fs-small: 0.9rem;` +
  `--pm-fs-xs: 0.85rem;` +
  `--pm-fs-tiny: 0.78rem;` +
  `--pm-lh-tight: 1.2;` +
  `--pm-lh-heading: 1.35;` +
  `--pm-lh-body: 1.6;`

const brandUrl = new URL(product.homeHref, SITE.url).href


/* Every product surface (hero and closing CTA box) is theme-aware, so the
   ghost button needs no per-surface variant any more. */
function actionClass(action: ProductAction) {
  return action.variant === 'ghost'
    ? stylex.attrs(styles.pmCta, styles.pmCtaGhost)
    : stylex.attrs(styles.pmCta)
}

function actionProps(action: ProductAction) {
  if (action.external) return { target: '_blank', rel: 'noopener noreferrer' }
  return {}
}
---

<div data-pm-hook="pm-page" {...stylex.attrs(styles.pmPage)} style={themeCss}>
  <nav data-pm-hook="pm-subnav" {...stylex.attrs(styles.pmSubnav)} aria-label={`${product.name} sections`}>
    <div data-pm-hook="pm-container" {...stylex.attrs(styles.pmContainer, styles.pmSubnavContainer)}>
      <a data-pm-hook="pm-brand" {...stylex.attrs(styles.pmBrand)} href={brandUrl} aria-label={`${product.name} home`}>
        <svg {...stylex.attrs(styles.pmBrandIcon)} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.6a1 1 0 0 1-.7-1.7L8 10h-.8a1 1 0 0 1-.7-1.6L11 5.5a1 1 0 0 1 1.4 0l4.5 2.9a1 1 0 0 1-.7 1.6H15l2.3 2.3a1 1 0 0 1-.7 1.7Z"/></svg>
        <span>{product.name}</span>
      </a>
      <div data-pm-hook="pm-subnav-links" {...stylex.attrs(styles.pmSubnavLinks)}>
        {
          product.navLinks.map((link) => (
            <a data-pm-hook="pm-subnav-link" {...stylex.attrs(styles.pmSubnavLink)} href={link.href}>
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>

  <section data-pm-hook="pm-hero" {...stylex.attrs(styles.pmHero)}>
    <div data-pm-hook="pm-hero-grid" {...stylex.attrs(styles.pmHeroGrid)}>
      <div data-pm-hook="pm-hero-left" {...stylex.attrs(styles.pmHeroLeft)}>
        <span data-pm-hook="pm-hero-tag" {...stylex.attrs(styles.pmHeroTag)}>{product.hero.tag}</span>
        <h1 data-pm-hook="pm-hero-title" {...stylex.attrs(styles.pmHeroTitle)}>{product.hero.title}</h1>
        <p data-pm-hook="pm-hero-sub" {...stylex.attrs(styles.pmHeroSub)}>{product.hero.sub}</p>
        <div data-pm-hook="pm-hero-actions" {...stylex.attrs(styles.pmHeroActions)}>
          {
            product.hero.actions.map((action) => (
              <a {...actionClass(action)} href={action.href} {...actionProps(action)}>
                {action.icon === 'launch' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 11 7-8 7 8"/><path d="M5 18h14"/><path d="M5 22h14"/></svg>
                )}
                {action.label}
                {action.icon === 'arrow' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
                )}
              </a>
            ))
          }
        </div>
        <ul data-pm-hook="pm-hero-checks" {...stylex.attrs(styles.pmHeroChecks)}>
          {product.hero.checks.map((check) => (
            <li {...stylex.attrs(styles.pmHeroCheck)}>
              <svg {...stylex.attrs(styles.pmHeroCheckIcon)} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 7" /></svg>
              <span>{check}</span>
            </li>
          ))}
        </ul>
      </div>

      <div data-pm-hook="pm-hero-right" {...stylex.attrs(styles.pmHeroRight)}>
        <slot name="media" />
      </div>
    </div>
  </section>

  <slot />

  <section data-pm-hook="pm-section" {...stylex.attrs(styles.pmSection)}>
    <div data-pm-hook="pm-container" {...stylex.attrs(styles.pmContainer)}>
      <div data-pm-hook="pm-cta-box" {...stylex.attrs(styles.pmCtaBox)}>
        <h2 data-pm-hook="pm-cta-title" {...stylex.attrs(styles.pmCtaTitle)}>{product.cta.title}</h2>
        <p data-pm-hook="pm-cta-text" {...stylex.attrs(styles.pmCtaText)}>{product.cta.text}</p>
        <div data-pm-hook="pm-cta-actions" {...stylex.attrs(styles.pmCtaActions)}>
          {
            product.cta.actions.map((action) => (
              <a {...actionClass(action)} href={action.href} {...actionProps(action)}>
                {action.icon === 'launch' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 11 7-8 7 8"/><path d="M5 18h14"/><path d="M5 22h14"/></svg>
                )}
                {action.label}
                {action.icon === 'arrow' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</div>
