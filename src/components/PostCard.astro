---
import type { CollectionEntry } from 'astro:content'
import { decodeEntities, ensureTrailingSlash, formatShortDate, readingTime, toISODate } from '../lib/utils'

interface Props {
  post: CollectionEntry<'blog'>
  headingLevel?: 'h2' | 'h3'
}

const { post, headingLevel = 'h2' } = Astro.props
const { title, date, description, permalink } = post.data
const url = ensureTrailingSlash(permalink)
const HeadingTag = headingLevel
---

<li class="group py-5">
  <time class="text-[0.775rem] font-medium uppercase tracking-[0.12em] text-faint transition-colors duration-200 group-hover:text-sub" datetime={toISODate(date)}>
    {formatShortDate(date)}
  </time>

  <HeadingTag class="mt-1 text-[1.2rem] font-semibold leading-snug tracking-[-0.01em] transition-transform duration-200 ease-out group-hover:translate-x-1">
    <a
      href={url}
      class="text-ink decoration-accent/30 no-underline underline-offset-3 transition-colors duration-200 group-hover:text-accent group-hover:underline"
    >
      {decodeEntities(title)}
    </a>
  </HeadingTag>

  {description && (
    <p class="mt-1.5 text-[0.95rem] leading-relaxed text-mid">
      {description}
    </p>
  )}
</li>