---
import { getCollection } from 'astro:content'
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import PageLayout, { type PageType } from '../layouts/PageLayout.astro'
import { SCHEMA_IDS, SITE } from '../config'
import Paragraph from '../components/markdown/Paragraph.astro'
import Heading2 from '../components/markdown/Heading2.astro'
import Heading3 from '../components/markdown/Heading3.astro'
import Heading4 from '../components/markdown/Heading4.astro'
import UnorderedList from '../components/markdown/UnorderedList.astro'
import OrderedList from '../components/markdown/OrderedList.astro'
import ListItem from '../components/markdown/ListItem.astro'
import Link from '../components/markdown/Link.astro'
import Quote from '../components/markdown/Quote.astro'
import Code from '../components/markdown/Code.astro'
import Pre from '../components/markdown/Pre.astro'
import Rule from '../components/markdown/Rule.astro'
import Image from '../components/markdown/Image.astro'
import Table from '../components/markdown/Table.astro'
import TableHead from '../components/markdown/TableHead.astro'
import TableBody from '../components/markdown/TableBody.astro'
import TableRow from '../components/markdown/TableRow.astro'
import TableCell from '../components/markdown/TableCell.astro'
import TableHeader from '../components/markdown/TableHeader.astro'
import Strong from '../components/markdown/Strong.astro'
import Kbd from '../components/markdown/Kbd.astro'

export async function getStaticPaths() {
  const metaTitles: Record<string, string> = {
    '/about/': 'About ~ Yoosuf Mohamed — Systems Architect & AI Engineer',
    '/contact/': 'Contact ~ Yoosuf Mohamed — Systems Architect',
    '/terms/': 'Terms of Service ~ Yoosuf Mohamed',
    '/terms-payments/': 'Terms & Payments ~ Yoosuf Mohamed',
    '/privacy/': 'Privacy Policy ~ Yoosuf Mohamed',
    '/yoosuf/': 'Yoosuf — Yoosuf Mohamed, Systems Architect & AI Engineer',
  }

  // Each page gets the schema type that actually describes it, and points at
  // the entity it is about so the person/site graph stays connected.
  const pageTypes: Record<string, { pageType?: PageType; mainEntity?: string }> = {
    '/about/': { pageType: 'AboutPage', mainEntity: SCHEMA_IDS.person },
    '/contact/': { pageType: 'ContactPage', mainEntity: SCHEMA_IDS.person },
    '/yoosuf/': { pageType: 'ProfilePage', mainEntity: SCHEMA_IDS.person },
  }

  const entries = await getCollection('pages')
  return entries.map((entry) => {
    const { permalink } = entry.data
    const slug = permalink.replace(/^\/+|\/+$/g, '')
    const types = pageTypes[permalink] ?? {}
    return {
      params: { slug },
      props: {
        entry,
        metaTitle: metaTitles[permalink] ?? null,
        pageType: types.pageType ?? ('WebPage' as PageType),
        mainEntity: types.mainEntity ?? null,
        jsonLd: [],
      },
    }
  })
}

interface Props {
  entry: CollectionEntry<'pages'>
  metaTitle: string | null
  pageType: PageType
  mainEntity: string | null
  jsonLd: object[]
}

const { entry, metaTitle, pageType, mainEntity, jsonLd } = Astro.props
const { Content } = await render(entry)
const { title, description, permalink } = entry.data
const markdownComponents = {
  p: Paragraph, h2: Heading2, h3: Heading3, h4: Heading4, ul: UnorderedList, ol: OrderedList,
  li: ListItem, a: Link, blockquote: Quote, code: Code, pre: Pre, hr: Rule, img: Image,
  table: Table, thead: TableHead, tbody: TableBody, tr: TableRow, td: TableCell, th: TableHeader,
  strong: Strong, kbd: Kbd,
}
---

<PageLayout
  title={title}
  metaTitle={metaTitle ?? title}
  description={description}
  canonical={permalink}
  pageType={pageType}
  mainEntity={mainEntity ?? undefined}
  jsonLd={jsonLd}
>
  <Content components={markdownComponents} />
</PageLayout>
