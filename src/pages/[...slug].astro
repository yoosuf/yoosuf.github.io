---
import { getCollection } from 'astro:content'
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import PageLayout from '../layouts/PageLayout.astro'
import { SITE } from '../config'

export async function getStaticPaths() {
  const metaTitles: Record<string, string> = {
    '/about/': 'About ~ Yoosuf Mohamed — Systems Architect & AI Engineer',
    '/contact/': 'Contact ~ Yoosuf Mohamed — Systems Architect',
    '/terms/': 'Terms of Service ~ Yoosuf Mohamed',
    '/terms-payments/': 'Terms & Payments ~ Yoosuf Mohamed',
    '/privacy/': 'Privacy Policy ~ Yoosuf Mohamed',
    '/yoosuf/': 'Yoosuf — Yoosuf Mohamed, Systems Architect & AI Engineer',
  }

  const profileJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: 'Yoosuf',
    url: `${SITE.url}/yoosuf/`,
    mainEntity: {
      '@type': 'Person',
      name: 'Yoosuf Mohamed',
      alternateName: ['Yoosuf', 'Yoosuf Mo', 'aitchdei'],
      url: SITE.url,
      image: `${SITE.url}/assets/images/yoosuf.jpg`,
      jobTitle: ['Systems Architect', 'AI Engineer', 'Software Architect', 'Technical Consultant'],
      description:
        'Yoosuf is Yoosuf Mohamed, also known as Yoosuf Mo and aitchdei. He is a systems architect, AI engineer, software architect, and technical consultant based in Colombo, Sri Lanka.',
      knowsAbout: [
        'AI automation', 'LLM', 'RAG', 'AI agents', 'systems architecture',
        'software architecture', 'SaaS architecture', 'Go', 'Elixir', 'FastAPI',
        'Node.js', 'Next.js', 'React', 'Flutter', 'AWS',
      ],
      sameAs: [
        'https://twitter.com/aitchdei',
        'https://www.linkedin.com/in/yoosufm',
        'https://github.com/yoosuf',
        'https://www.instagram.com/aitchdei',
        'https://www.youtube.com/@YoosufMo',
        'https://yoosuf.medium.com',
      ],
    },
  }

  const entries = await getCollection('pages')
  return entries.map((entry) => {
    const { permalink } = entry.data
    const slug = permalink.replace(/^\/+|\/+$/g, '')
    return {
      params: { slug },
      props: {
        entry,
        metaTitle: metaTitles[permalink] ?? null,
        jsonLd: permalink === '/yoosuf/' ? [profileJsonLd] : [],
      },
    }
  })
}

interface Props {
  entry: CollectionEntry<'pages'>
  metaTitle: string | null
  jsonLd: object[]
}

const { entry, metaTitle, jsonLd } = Astro.props
const { Content } = await render(entry)
const { title, description, permalink } = entry.data
---

<PageLayout
  title={title}
  metaTitle={metaTitle ?? title}
  description={description}
  canonical={permalink}
  jsonLd={jsonLd}
>
  <Content />
</PageLayout>