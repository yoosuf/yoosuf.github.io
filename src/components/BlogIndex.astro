---
import type { CollectionEntry } from 'astro:content'
import Breadcrumbs from './Breadcrumbs.astro'
import PostCard from './PostCard.astro'
import { POSTS_PER_PAGE } from '../lib/pagination'

interface Props {
  posts: CollectionEntry<'blog'>[]
  currentPage: number
  totalPages: number
  totalPosts: number
  infinite?: boolean
}

const { posts, currentPage, totalPages, totalPosts, infinite = false } = Astro.props
const pageUrl = (n: number) => (n === 1 ? '/blog/' : `/blog/page/${n}/`)
const start = (currentPage - 1) * POSTS_PER_PAGE + 1
const end = start + posts.length - 1

const pageLinkClass =
  'flex h-9 min-w-9 items-center justify-center rounded-md border px-2 text-[0.9rem] font-medium text-mid no-underline transition-colors hover:border-ink/30 hover:text-accent'
const pageLinkDisabled =
  'flex h-9 min-w-9 items-center justify-center rounded-md border border-line px-2 text-[0.9rem] text-faint'
const pageLinkCurrent =
  'flex h-9 min-w-9 items-center justify-center rounded-md border border-accent bg-accent px-2 text-[0.9rem] font-semibold text-white'
---

<article class="site-container py-14 sm:py-20">
  <Breadcrumbs items={[{ label: 'Blog' }]} />

  <header>
    <h1 class="mt-8 text-[2rem] sm:text-[2.4rem] font-semibold tracking-[-0.025em] leading-snug text-ink">
      Blog
    </h1>

    <p class="mt-4 max-w-[42rem] text-[0.95rem] leading-relaxed text-mid">
      Notes, thoughts, and deep dives on AI, systems architecture, and software engineering —
      from over a decade building products.
    </p>

    <p class="mt-3 text-[0.85rem] text-sub" data-blog-summary>
      Showing {start}–{end} of {totalPosts} posts
    </p>
  </header>

  <ul
    class="mt-10 divide-y divide-line border-t border-b border-line"
    data-infinite-list
    data-total={totalPosts}
  >
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </ul>

  {infinite ? (
    <>
      <div
        class="h-px w-full"
        data-infinite-sentinel
        data-next={currentPage + 1}
        data-last={totalPages}
        aria-hidden="true"
      ></div>

      <p class="sr-only" data-infinite-status role="status"></p>

      {totalPages > 1 && (
        <div class="mt-10 flex flex-col items-center gap-4 border-t border-line pt-8">
          <button
            type="button"
            data-infinite-button
            class="inline-flex h-10 items-center justify-center rounded-md border border-line px-6 text-[0.9rem] font-medium text-mid transition-colors hover:border-accent/40 hover:text-accent"
          >
            Load more posts
          </button>

          <noscript>
            <div class="flex flex-col items-center gap-2">
              {Array.from({ length: totalPages }, (_, i) => i + 2).map((n) => (
                <a href={pageUrl(n)} class="text-[0.9rem] text-accent no-underline hover:underline">
                  Older posts — page {n}
                </a>
              ))}
            </div>
          </noscript>
        </div>
      )}
    </>
  ) : (
    totalPages > 1 && (
      <nav aria-label="Blog pages" class="mt-10 flex flex-col items-center gap-4 border-t border-line pt-8">
        <p class="text-[0.85rem] text-sub">
          Page {currentPage} of {totalPages}
        </p>

        <ul class="flex flex-wrap items-center justify-center gap-2">
          <li>
            {currentPage > 1 ? (
              <a href={pageUrl(currentPage - 1)} class={pageLinkClass} aria-label="Previous page">
                ←
              </a>
            ) : (
              <span class={pageLinkDisabled} aria-hidden="true">
                ←
              </span>
            )}
          </li>

          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) =>
            n === currentPage ? (
              <li key={n}>
                <span aria-current="page" class={pageLinkCurrent}>
                  {n}
                </span>
              </li>
            ) : (
              <li key={n}>
                <a href={pageUrl(n)} class={pageLinkClass}>
                  {n}
                </a>
              </li>
            ),
          )}

          <li>
            {currentPage < totalPages ? (
              <a href={pageUrl(currentPage + 1)} class={pageLinkClass} aria-label="Next page">
                →
              </a>
            ) : (
              <span class={pageLinkDisabled} aria-hidden="true">
                →
              </span>
            )}
          </li>
        </ul>
      </nav>
    )
  )}
</article>

<script>
  import { initInfiniteScroll } from '../scripts/infiniteScroll'
  initInfiniteScroll()
</script>