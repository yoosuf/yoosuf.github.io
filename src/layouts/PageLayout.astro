---
import * as stylex from '@stylexjs/stylex'
import BaseLayout from './BaseLayout.astro'
import { Breadcrumbs } from '../components/ui/Breadcrumbs'
import { pageStyles } from '../components/ui/page.stylex'
import { shellStyles } from '../components/ui/shell.stylex'
import { SITE } from '../config'

export type PageType =
  | 'WebPage'
  | 'CollectionPage'
  | 'ItemPage'
  | 'ProfilePage'
  | 'AboutPage'
  | 'ContactPage'

interface Props {
  title: string
  metaTitle?: string
  description?: string
  canonical: string
  pageType?: PageType
  mainEntity?: string
  jsonLd?: object[]
  type?: 'website' | 'article' | 'profile' | 'softwareApplication'
}

const {
  title,
  metaTitle,
  description,
  canonical,
  pageType = 'WebPage',
  mainEntity,
  jsonLd = [],
  type = 'website',
} = Astro.props
const proseAttrs = stylex.attrs(shellStyles.prose)
---

<BaseLayout
  title={metaTitle ?? title}
  description={description}
  canonical={canonical}
  pageType={pageType}
  mainEntity={mainEntity}
  type={type}
  jsonLd={jsonLd}
>
  <article {...stylex.attrs(pageStyles.page, pageStyles.container)}>
      <Breadcrumbs items={[{ label: title }]} baseUrl={SITE.url} />

      <header {...stylex.attrs(pageStyles.header)}>
        <h1 {...stylex.attrs(pageStyles.title)}>{title}</h1>
      </header>

      <div {...proseAttrs}>
        <slot />
      </div>
  </article>
</BaseLayout>
